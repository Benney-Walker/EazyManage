<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bbquantum.eazymanage.Controller.SwitchRoleController"
           fx:id="notification"
           styleClass="auth-root">

    <stylesheets>
        <URL value="@../Styles/Styles.css"/>
    </stylesheets>

    <VBox fx:id="switchRolePanel"
          spacing="10"
          maxHeight="300"
          maxWidth="400"
          styleClass="sub-panel">

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="staffName" styleClass="section-title-small"/>
            <Label text="Select Role" styleClass="input-label"/>
        </VBox>

        <Separator styleClass="content-separator"/>
        <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="300">
            <Button fx:id="rolePrincipalBtn"
                    text="PRINCIPAL"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button fx:id="roleAdminBtn"
                    text="ADMINISTRATOR"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button fx:id="roleStaffBtn"
                    text="TEACHING_STAFF"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button fx:id="roleFinanceBtn"
                    text="ACCOUNTANT"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>
        </VBox>

        <Separator styleClass="content-separator"/>

        <HBox spacing="10">
            <Button fx:id="roleSwitchBtn"
                    text="VIEW PAGE"
                    styleClass="action-button-primary"
                    onAction="#handleSwitchRoles"/>

            <Button fx:id="logoutButton"
                    text="SIGN OUT"
                    styleClass="action-button-orange"
                    onAction="#handleLogout"/>
        </HBox>

        <Label fx:id="errorMessageLabel"
               visible="false"
               managed="false"
               styleClass="message-error"/>
    </VBox>
</StackPane>
