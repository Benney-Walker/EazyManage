                                        </effect>
                                    </Button>

                                    <Button text="🔑 Recover Password" onAction="#handleRecoverPassword"
                                            style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                        <effect>
                                            <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                        </effect>
                                    </Button>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Search Result / Staff Details Panel (Hidden by default) -->
                        <VBox fx:id="staffDetailsPanel" spacing="20" visible="false" managed="false"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 25; -fx-border-color: #667eea; -fx-border-width: 2; -fx-border-radius: 10;">

                            <!-- Staff Info Header -->
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="👤" style="-fx-font-size: 32px;"/>
                                <VBox spacing="3">
                                    <Label fx:id="staffFullNameLabel" text="Staff Name" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <Label fx:id="staffRoleLabel" text="Role" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                </VBox>
                            </HBox>

                            <Separator/>

                            <!-- Editable Staff Information -->
                            <GridPane hgap="15" vgap="15">

                                <!-- First Name -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="First Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <TextField fx:id="editFirstNameField"
                                               style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                                </VBox>

                                <!-- Last Name -->
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Last Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <TextField fx:id="editLastNameField"
                                               style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                                </VBox>

                                <!-- Email -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <TextField fx:id="editEmailField"
                                               style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                                </VBox>

                                <!-- Phone Number -->
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <TextField fx:id="editPhoneField"
                                               style="-fx-padding: 10; -fx-font-size: 13px; -fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                                </VBox>

                                <!-- Date of Birth -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Date of Birth *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <DatePicker fx:id="editDateOfBirthPicker" style="-fx-font-size: 13px;"/>
                                </VBox>

                                <!-- Gender -->
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Gender *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <HBox spacing="15">
                                        <RadioButton fx:id="editMaleRadio" text="Male" style="-fx-font-size: 12px;">
                                            <toggleGroup>
                                                <ToggleGroup fx:id="editGenderGroup"/>
                                            </toggleGroup>
                                        </RadioButton>
                                        <RadioButton fx:id="editFemaleRadio" text="Female" toggleGroup="$editGenderGroup" style="-fx-font-size: 12px;"/>
                                    </HBox>
                                </VBox>

                                <!-- Role -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                    <Label text="Role *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                                    <ComboBox fx:id="editRoleComboBox" maxWidth="Infinity" style="-fx-font-size: 13px;"/>
                                </VBox>
                            </GridPane>

                            <!-- Error/Success Message -->
                            <Label fx:id="staffUpdateMessageLabel" wrapText="true" style="-fx-font-size: 12px; -fx-padding: 5;" visible="false"/>

                            <!-- Action Buttons -->
                            <HBox spacing="15" alignment="CENTER_RIGHT">
                                <Button text="Cancel" onAction="#handleCancelUpdate"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                                <Button text="💾 Save Changes" onAction="#handleUpdateStaff"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;">
                                    <effect>
                                        <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                    </effect>
                                </Button>
                            </HBox>
                        </VBox>

                        <!-- No Staff Found Message (Hidden by default) -->
                        <VBox fx:id="noStaffFoundPanel" spacing="10" alignment="CENTER" visible="false" managed="false"
                              style="-fx-background-color: #fff3cd; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #ffc107; -fx-border-width: 2; -fx-border-radius: 8;">
                            <Label text="⚠️" style="-fx-font-size: 32px;"/>
                            <Label text="Staff Not Found" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #856404;"/>
                            <Label text="No staff member exists with this ID" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
                        </VBox>
                    </VBox>

                    <!-- All Staff List Section -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋 Staff List" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Refresh" onAction="#refreshStaffList"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator/>

                        <!-- Staff Table -->
                        <TableView fx:id="allStaffTable" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn text="Staff ID" prefWidth="120" fx:id="staffIdColumn"/>
                                <TableColumn text="Full Name" prefWidth="200" fx:id="staffNameColumn"/>
                                <TableColumn text="Assigned Grade" prefWidth="200" fx:id="staffGradeColumn"/>
                                <TableColumn text="Assigned Subject" prefWidth="130" fx:id="staffSubjectColumn"/>
                            </columns>
                            <placeholder>
                                <Label text="No staff members found" style="-fx-text-fill: #95a5a6;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

</BorderPane>