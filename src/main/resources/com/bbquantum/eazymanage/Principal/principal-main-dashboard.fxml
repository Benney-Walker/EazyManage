<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.PrincipalController"
            fx:id="notification">

    <BorderPane styleClass="principal-root">
        <stylesheets>
            <URL value="@../Styles/Styles.css"/>
        </stylesheets>

        <!-- LEFT SIDEBAR - Navigation -->
        <left>
            <VBox prefWidth="250" minWidth="250" styleClass="sidebar">

                <VBox alignment="CENTER" spacing="10" styleClass="sidebar-header">
                    <StackPane styleClass="logo-container">
                        <Label text="EM" styleClass="logo-text"/>
                    </StackPane>
                    <Label text="EAZY MANAGE" styleClass="brand-name"/>
                    <Label text="V 2.0.0" styleClass="version-badge"/>
                </VBox>

                <Separator styleClass="sidebar-separator"/>

                <VBox spacing="8" styleClass="nav-container">
                    <Button fx:id="mainDashboardBtn" text="📊 Main Dashboard" onAction="#showMainDashboard"
                            maxWidth="Infinity" styleClass="nav-button, nav-button-active"/>

                    <Button fx:id="staffDashboardBtn" text="👥 Staff Dashboard" onAction="#showStaffDashboard"
                            maxWidth="Infinity" styleClass="nav-button"/>

                    <Button fx:id="financeDashboardBtn" text="💰 Finance Dashboard" onAction="#showFinanceDashboard"
                            maxWidth="Infinity" styleClass="nav-button"/>

                    <Button fx:id="studentDashboardBtn" text="🎒 Student Dashboard" onAction="#showStudentDashboard"
                            maxWidth="Infinity" styleClass="nav-button"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="15" styleClass="sidebar-footer">
                    <Separator styleClass="sidebar-separator"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="👤" style="-fx-font-size: 24px;"/>
                        <VBox spacing="2">
                            <Label fx:id="institutionNameLabel" text="School Name" styleClass="user-label-bold"/>
                            <Label fx:id="principalNameLabel" text="Principal Name" styleClass="user-label-sub"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout"
                            maxWidth="Infinity" styleClass="logout-button"/>
                </VBox>
            </VBox>
        </left>

        <!-- RIGHT CONTENT AREA -->
        <center>
            <StackPane fx:id="contentArea" styleClass="main-content-bg">

                <!-- MAIN DASHBOARD VIEW (Default) -->
                <ScrollPane fx:id="mainDashboardView" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="25" styleClass="content-padding">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5">
                                <Label text="Main Dashboard" styleClass="header-title"/>
                                <Label fx:id="dateTimeLabel" text="Monday, December 29, 2025 | 12:00 PM" styleClass="header-subtitle"/>
                            </VBox>
                        </HBox>

                        <!-- Statistics Cards -->
                        <GridPane hgap="25" vgap="25">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>

                            <!-- Total Students Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="🎓" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Students" styleClass="card-label"/>
                                        <Label fx:id="totalStudentsLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Currently enrolled in system" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Staff Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="👥" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Staff" styleClass="card-label"/>
                                        <Label fx:id="totalStaffLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Active staff members" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Semester Fees Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="💵" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Semester Fees" styleClass="card-label"/>
                                        <Label fx:id="semesterFeesLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Expected revenue this term" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Fees Paid Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="✅" styleClass="card-icon-bg-green"/>
                                    <VBox spacing="5">
                                        <Label text="Fees Paid" styleClass="card-label"/>
                                        <Label fx:id="feesPaidLabel" text="GH₵ 0.00" styleClass="card-value-green"/>
                                    </VBox>
                                </HBox>
                                <ProgressBar fx:id="feesProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                            </VBox>
                        </GridPane>

                        <!-- Recently Added Students Section -->
                        <VBox spacing="15" styleClass="table-container-card">

                            <!-- Students Table -->
                            <TableView fx:id="recentStudentsTable" styleClass="modern-table">
                                <columns>
                                    <TableColumn text="Student ID" fx:id="studentIdColumn" prefWidth="120"/>
                                    <TableColumn text="Name" fx:id="studentNameColumn" prefWidth="250"/>
                                    <TableColumn text="Level" fx:id="studentLevelColumn" prefWidth="120"/>
                                    <TableColumn text="Date Added" fx:id="dateAddedColumn" prefWidth="180"/>
                                    <TableColumn text="Status" fx:id="statusColumn" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </ScrollPane>



                <!--
                PRINCIPAL FINANCE DASHBOARD
                -->
                <ScrollPane fx:id="financeDashboardView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="25" styleClass="content-padding">

                        <!-- Header -->
                        <VBox spacing="5">
                            <Label text="Finance Dashboard" styleClass="header-title"/>
                            <Label text="Monitor fees and payment records" styleClass="header-subtitle"/>
                        </VBox>

                        <!-- Financial Summary Cards -->
                        <HBox spacing="20">
                            <!-- Total Semester Fees Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="💵" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Semester Fees" styleClass="card-label"/>
                                        <Label fx:id="totalSemesterFeesLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Expected revenue for current semester" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Amount Paid Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label text="✅" styleClass="card-icon-bg-green"/>
                                    <VBox spacing="5">
                                        <Label text="Amount Paid" styleClass="card-label"/>
                                        <Label fx:id="amountPaidLabel" text="GH₵ 0.00" styleClass="card-value-green"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="collectionPercentageLabel" text="0%" styleClass="percentage-label"/>
                                        <Label text="collected" styleClass="card-footer-text"/>
                                    </HBox>
                                    <ProgressBar fx:id="collectionProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                                </VBox>
                            </VBox>

                            <!-- Outstanding Balance Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="⏳" styleClass="card-icon-bg-red"/>
                                    <VBox spacing="5">
                                        <Label text="Outstanding" styleClass="card-label"/>
                                        <Label fx:id="outstandingBalanceLabel" text="GH₵ 0.00" styleClass="card-value-red"/>
                                    </VBox>
                                </HBox>
                                <Label text="Pending payments" styleClass="card-footer-text"/>
                            </VBox>
                        </HBox>

                        <!-- Student Fee Report Search Section -->
                        <VBox spacing="20" styleClass="stat-card">

                            <Label text="🔍 Student Fee Report" styleClass="section-title"/>
                            <Separator styleClass="content-separator"/>
                            <!-- Search Filters -->
                            <GridPane hgap="20" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="25"/>
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="25"/>
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="25"/>
                                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="25"/>
                                </columnConstraints>

                                <!-- Student ID Search -->
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Student ID" styleClass="input-label"/>
                                    <TextField fx:id="studentIdSearchField" promptText="Enter Student ID" styleClass="modern-input"/>
                                </VBox>

                                <!-- Semester Selection -->
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Semester" styleClass="input-label"/>
                                    <ComboBox fx:id="semesterComboBox" promptText="Select Semester" maxWidth="Infinity" styleClass="modern-combo"/>
                                </VBox>

                                <!-- Class/Level Selection -->
                                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Class/Level" styleClass="input-label"/>
                                    <ComboBox fx:id="classLevelComboBox" promptText="Select Class" maxWidth="Infinity" styleClass="modern-combo"/>
                                </VBox>

                                <!-- Search Button -->
                                <VBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="0" alignment="BOTTOM_LEFT">
                                    <Button fx:id="searchFeesHistoryBtn" text="🔍 Search Records" onAction="#handleSearchStudentFees"
                                            maxWidth="Infinity" styleClass="action-button-primary"/>
                                </VBox>
                            </GridPane>

                            <!-- Quick Filter Buttons -->
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Quick Filters:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                <Button fx:id="fullyPaidBtn" text="Fully Paid" onAction="#showFullyPaid" styleClass="filter-pill-green"/>
                                <Button fx:id="partiallyPaidBtn" text="Partial Payment" onAction="#showPartialPayment" styleClass="filter-pill-yellow"/>
                                <Button fx:id="notPaidBtn" text="Not Paid" onAction="#showNotPaid" styleClass="filter-pill-red"/>
                            </HBox>

                            <!-- Filtered Students Table (Hidden by default) -->
                            <VBox fx:id="filteredStudentsPanel" spacing="15" visible="false" managed="false" styleClass="sub-panel">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="filterTitleLabel" text="Filtered Students" styleClass="section-title-small"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="filteredCountLabel" text="0 students found" style="-fx-text-fill: #64748B;"/>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Filtered Students Table -->
                                <TableView fx:id="filteredStudentsTable" styleClass="modern-table" maxHeight="400">
                                    <columns>
                                        <TableColumn text="Student ID" fx:id="filteredStudentIdColumn" prefWidth="120"/>
                                        <TableColumn text="Student Name" fx:id="filteredStudentNameColumn" prefWidth="180"/>
                                        <TableColumn text="Class" fx:id="filteredStudentClassColumn" prefWidth="100"/>
                                        <TableColumn text="Total Fees" fx:id="filteredTotalFeesColumn" prefWidth="110"/>
                                        <TableColumn text="Amount Paid" fx:id="filteredAmountPaidColumn" prefWidth="120"/>
                                        <TableColumn text="Balance" fx:id="filteredBalanceColumn" prefWidth="110"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No students match this filter" style="-fx-text-fill: #95a5a6;"/>
                                    </placeholder>
                                </TableView>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="Clear Filter" onAction="#handleClearFilter" styleClass="action-button-outline"/>
                                    <Button text="📥 Export List" onAction="#handleExportFilteredList" styleClass="action-button-mint"/>
                                </HBox>
                            </VBox>

                            <!-- Student Fee Report Result (Hidden by default) -->
                            <VBox fx:id="feeReportPanel" spacing="20" visible="false" managed="false" styleClass="sub-panel">

                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <StackPane style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-padding: 10;">
                                        <Label text="🎓" style="-fx-font-size: 24px;"/>
                                    </StackPane>
                                    <VBox spacing="5">
                                        <Label fx:id="studentNameLabel" text="Student Name" styleClass="header-title-small"/>
                                        <HBox spacing="10">
                                            <Label fx:id="studentIdDisplayLabel" text="ID: 102030" styleClass="tag-label"/>
                                            <Label fx:id="studentClassLabel" text="Form 1A" styleClass="tag-label"/>
                                            <Label fx:id="studentSemesterLabel" text="1st Semester" styleClass="tag-label"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Fee Breakdown -->
                                <GridPane hgap="20" vgap="15">

                                    <!-- Total Fees -->
                                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Total Fees" styleClass="input-label"/>
                                        <Label fx:id="studentTotalFeesLabel" text="GH₵ 0.00" styleClass="value-large"/>
                                    </VBox>

                                    <!-- Amount Paid -->
                                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Amount Paid" styleClass="input-label"/>
                                        <Label fx:id="studentAmountPaidLabel" text="GH₵ 0.00" styleClass="value-large-green"/>
                                    </VBox>

                                    <!-- Balance -->
                                    <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                        <Label text="Balance" styleClass="input-label"/>
                                        <Label fx:id="studentBalanceLabel" text="GH₵ 0.00" styleClass="value-large-red"/>
                                    </VBox>
                                </GridPane>

                                <!-- Progress Bar -->
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Payment Progress" styleClass="input-label"/>
                                        <Label fx:id="studentPaymentPercentageLabel" text="0%" style="-fx-text-fill: #10B981; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <ProgressBar fx:id="studentPaymentProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                                </VBox>

                                <!-- Payment History Table -->
                                <VBox spacing="10">
                                    <Label text="Payment History" styleClass="section-title-small"/>
                                    <TableView fx:id="paymentHistoryTable" styleClass="modern-table" maxHeight="200">
                                        <columns>
                                            <TableColumn text="Date" fx:id="paymentDateColumn" prefWidth="120"/>
                                            <TableColumn text="Amount Paid" fx:id="paymentAmountColumn" prefWidth="120"/>
                                            <TableColumn text="Payer" fx:id="paymentPersonColumn" prefWidth="130"/>
                                            <TableColumn text="Contact" fx:id="paymentPersonContactColumn" prefWidth="120"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="No payment records found" style="-fx-text-fill: #94A3B8;"/>
                                        </placeholder>
                                    </TableView>
                                </VBox>

                                <!-- Actions -->
                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="📄 Print Report" onAction="#handlePrintReport" styleClass="action-button-primary"/>
                                </HBox>
                            </VBox>

                            <!-- No Student Found Message (Hidden by default) -->
                            <VBox fx:id="noStudentFoundPanel" spacing="10" alignment="CENTER" visible="false" managed="false" styleClass="alert-panel-warning">
                                <Label text="⚠️" style="-fx-font-size: 32px;"/>
                                <Label text="No Student Found" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #B45309;"/>
                                <Label text="Check the Student ID and try again." style="-fx-text-fill: #B45309;"/>
                            </VBox>
                        </VBox>

                        <!-- All Students Fee Summary Table -->
                        <VBox spacing="20" styleClass="stat-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📊 Fee Summary by Class" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="📥 Export to Excel" onAction="#handleExportToExcel" styleClass="action-button-mint"/>
                            </HBox>
                            <Separator styleClass="content-separator"/>

                            <!-- Summary Table -->
                            <TableView fx:id="classSummaryTable" styleClass="modern-table">
                                <columns>
                                    <TableColumn text="Grade/Level" fx:id="summaryClassColumn" prefWidth="150"/>
                                    <TableColumn text="Students" fx:id="summaryStudentCountColumn" prefWidth="120"/>
                                    <TableColumn text="Expected Fees" fx:id="summaryExpectedFeesColumn" prefWidth="140"/>
                                    <TableColumn text="Paid" fx:id="summaryAmountPaidColumn" prefWidth="140"/>
                                    <TableColumn text="Outstanding" fx:id="summaryOutstandingColumn" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="No data available" style="-fx-text-fill: #95a5a6;"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                    </VBox>
                </ScrollPane>



                <!--
                PRINCIPAL STUDENT DASHBOARD
                -->
                <ScrollPane fx:id="studentDashboardView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="30" styleClass="content-padding">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5">
                                <Label text="Student Dashboard" styleClass="header-title"/>
                                <Label text="Manage students, enrollments, and view academic records" styleClass="header-subtitle"/>
                            </VBox>
                        </HBox>

                        <!-- Quick Stats & Actions Row -->
                        <FlowPane hgap="20" vgap="20" prefWrapLength="1100">
                        <!-- Total Students Card -->
                            <VBox styleClass="stat-card"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="🎓" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Students" styleClass="card-label"/>
                                        <Label fx:id="totalStudentsCountLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Enrolled students" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Print Student List Section -->
                            <VBox styleClass="stat-card"
                                  minWidth="350"
                                  prefWidth="420"
                                  maxWidth="500"
                                  spacing="15">
                                <Label text="🖨️ Print Class Student List" styleClass="section-title-small"/>
                                <Separator styleClass="content-separator"/>

                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Select Class/Level" styleClass="input-label"/>
                                        <ComboBox fx:id="printStudentClassComboBox" promptText="Select Class" maxWidth="Infinity" styleClass="modern-combo"/>
                                    </VBox>
                                    <VBox spacing="5" alignment="BOTTOM_LEFT">
                                        <Button fx:id="printStudentDataBtn" text="🖨️ Print List" onAction="#handlePrintStudentData" styleClass="action-button-mint"/>
                                    </VBox>
                                </HBox>

                                <Label text="💡 This will generate a list of all students in the selected class with their Student IDs for easy reference."
                                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;"/>
                            </VBox>

                            <!-- Add Student Button Card -->
                            <VBox styleClass="card-add-student"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350"
                                  alignment="CENTER"
                                  spacing="10"
                                  onMouseClicked="#openAddStudentPage">
                                <Label text="➕" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                                <Label text="Add New Student" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Click to enroll a new student" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>

                            <!-- Add Grade Criteria Card -->
                            <VBox styleClass="card-add-student"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350"
                                  alignment="CENTER"
                                  spacing="10"
                                  onMouseClicked="#openAddGrades">

                                <Label text="➕" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                                <Label text="Add New Grading Criteria" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Click to criteria" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>

                            <!-- View Class Results Card -->
                            <VBox styleClass="card-add-student"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350"
                                  alignment="CENTER"
                                  spacing="10"
                                  onMouseClicked="#openClassResultsView">

                                <Label text="View Entire Class Results" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Click to Open Results Page" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>

                        </FlowPane>

                        <!-- Search Student by ID Section -->
                        <VBox spacing="20" styleClass="stat-card">
                            <Label text="🔍 Find Student Profile" styleClass="section-title"/>
                            <Separator styleClass="content-separator"/>

                            <!-- Search Bar -->
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Student ID" styleClass="input-label"/>
                                    <TextField fx:id="searchStudentIdField" promptText="Enter Student ID to search" styleClass="modern-input"/>
                                </VBox>
                                <VBox spacing="8" alignment="BOTTOM_LEFT">
                                    <Button fx:id="findStudent" text="🔍 Search Profile" onAction="#handleSearchStudent" styleClass="action-button-primary"/>
                                </VBox>
                            </HBox>

                            <!-- Student Details Panel (Hidden by default) -->
                            <VBox fx:id="studentDetailsPanel" spacing="20" visible="false" managed="false" styleClass="sub-panel">
                                <!-- Student Info Header -->
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <StackPane style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-padding: 10;">
                                        <Label text="🎓" style="-fx-font-size: 32px;"/>
                                    </StackPane>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label fx:id="studentFullNameLabel" text="Student Name" styleClass="header-title-small"/>
                                        <HBox spacing="10">
                                            <Label fx:id="studentIdLabelDisplay" text="ID:" styleClass="tag-label"/>
                                            <Label fx:id="studentClassLabelDisplay" text="Class:" styleClass="tag-label"/>
                                        </HBox>
                                        <Label fx:id="statusField" text="Student Status" styleClass="tag-label" />
                                    </VBox>
                                    <Button text="✏️ Edit Profile" onAction="#handleEditStudent" styleClass="action-button-outline"/>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Student Information Grid -->
                                <GridPane hgap="40" vgap="20">

                                    <!-- Personal Info Column -->
                                    <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Personal Information" styleClass="section-header-blue"/>
                                        <HBox spacing="15" alignment="CENTER_LEFT">
                                            <Label text="Gender:" styleClass="field-label"/>
                                            <Label fx:id="studentGenderLabel" text="Male" styleClass="field-value"/>
                                        </HBox>
                                        <HBox spacing="15" alignment="CENTER_LEFT">
                                            <Label text="Date of Birth:" styleClass="field-label"/>
                                            <Label fx:id="studentDOBLabel" text="2005-01-15" styleClass="field-value"/>
                                        </HBox>
                                    </VBox>

                                    <!-- Contact Info Column -->
