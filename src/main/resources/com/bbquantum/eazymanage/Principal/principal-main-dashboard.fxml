<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.PrincipalController"
            fx:id="notification">

    <stylesheets>
        <URL value="@../Styles/Styles.css"/>
    </stylesheets>

    <BorderPane styleClass="principal-root">

        <!-- LEFT SIDEBAR - Navigation -->
        <left>
            <VBox fx:id="navContentPage" prefWidth="250" styleClass="sidebar">

                <VBox alignment="CENTER" spacing="10" styleClass="sidebar-header">
                    <StackPane styleClass="logo-container">
                        <Label text="EM" styleClass="logo-text"/>
                    </StackPane>
                    <Label text="EAZY MANAGE" styleClass="brand-name"/>
                    <Label fx:id="versionLabel" text=" " styleClass="version-badge"/>
                </VBox>

                <Separator styleClass="sidebar-separator"/>

                <VBox spacing="8" styleClass="nav-container">
                    <Button fx:id="mainDashboardBtn"
                            text="MAIN DASHBOARD"
                            onAction="#showMainDashboard"
                            maxWidth="Infinity"
                            styleClass="nav-button,
                            nav-button-active"/>

                    <Button fx:id="staffDashboardBtn"
                            text="STAFF DASHBOARD"
                            onAction="#showStaffDashboard"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>

                    <Button fx:id="financeDashboardBtn"
                            text="FINANCE DASHBOARD"
                            onAction="#showFinanceDashboard"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>

                    <Button fx:id="studentDashboardBtn"
                            text="STUDENT DASHBOARD"
                            onAction="#showStudentDashboard"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="15" styleClass="sidebar-footer">
                    <Separator styleClass="sidebar-separator"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="👤" style="-fx-font-size: 24px;"/>
                        <VBox spacing="2">
                            <Label fx:id="principalNameLabel" text="School Name" styleClass="user-label-bold"/>
                            <Label fx:id="institutionNameLabel" text="Principal Name" styleClass="user-label-sub"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="switchRole" text="SWITCH ROLE" onAction="#handleOpenSwitchRole"
                            maxWidth="Infinity" styleClass="logout-button"/>
                </VBox>
            </VBox>
        </left>

        <!-- RIGHT CONTENT AREA -->
        <center>
            <StackPane fx:id="contentArea" styleClass="main-content-bg">

                <!-- MAIN DASHBOARD VIEW (Default) -->
                <ScrollPane fx:id="mainDashboardView" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="25" styleClass="content-padding">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="MAIN DASHBOARD" styleClass="header-title"/>
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                <Button fx:id="refreshDashboardBtn"
                                        text="REFRESH DASHBOARD"
                                        onAction="#refreshDashboard"
                                        styleClass="action-button-outline"/>
                            </VBox>
                        </HBox>

                        <!-- Statistics Cards -->
                        <GridPane hgap="25" vgap="25">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>

                            <!-- Total Students Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="🎓" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="TOTAL STUDENTS" styleClass="card-label"/>
                                        <Label fx:id="totalStudentsLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Currently enrolled in system" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Staff Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="👥" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="TOTAL STAFFS" styleClass="card-label"/>
                                        <Label fx:id="totalStaffLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Active staff members" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Semester Fees Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="💵" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="SEMESTER FEES" styleClass="card-label"/>
                                        <Label fx:id="semesterFeesLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Expected revenue this term" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Total Fees Paid Card -->
                            <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="✅" styleClass="card-icon-bg-green"/>
                                    <VBox spacing="5">
                                        <Label text="FEES PAID" styleClass="card-label"/>
                                        <Label fx:id="feesPaidLabel" text="GH₵ 0.00" styleClass="card-value-green"/>
                                    </VBox>
                                </HBox>
                                <ProgressBar fx:id="feesProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                            </VBox>
                        </GridPane>

                        <!-- Absentees for the day -->
                        <VBox spacing="15" styleClass="table-container-card">

                            <!-- Header / Context -->
                            <VBox spacing="4">
                                <Label text="ABSENTEES FOR TODAY"
                                       styleClass="section-title"/>

                                <Label text="Students who were marked ABSENT for the current day"
                                       styleClass="login-footer-label"
                                       style="-fx-opacity: 0.8;"/>
                            </VBox>

                            <!-- Optional info strip -->
                            <HBox spacing="10"
                                  alignment="CENTER_LEFT"
                                  styleClass="alert-panel-warning"
                                  style="-fx-padding: 8 12;">

                                <Label text="⚠️"/>
                                <Label text="This list updates automatically based on today's attendance records."
                                       styleClass="login-footer-label"/>
                            </HBox>

                            <!-- Absentees Table -->
                            <TableView fx:id="absenteesTable"
                                       styleClass="modern-table"
                                       prefHeight="300">

                                <columns>
                                    <TableColumn text="STUDENT ID" fx:id="studentIdColumn" prefWidth="120"/>
                                    <TableColumn text="NAME" fx:id="studentNameColumn" prefWidth="250"/>
                                    <TableColumn text="LEVEL" fx:id="studentLevelColumn" prefWidth="120"/>
                                    <TableColumn text="INSTRUCTOR" fx:id="instructorNameColumn" prefWidth="180"/>
                                    <TableColumn text="INSTRUCTOR ID" fx:id="instructorIdColumn" prefWidth="120"/>
                                </columns>

                                <placeholder>
                                    <VBox alignment="CENTER" spacing="6">
                                        <Label text="No Absentees for Today"
                                               style="-fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                                        <Label text="Perfect attendance recorded."
                                               styleClass="login-footer-label"/>
                                    </VBox>
                                </placeholder>

                            </TableView>

                        </VBox>


                    </VBox>
                </ScrollPane>

                <!-- PRINCIPAL FINANCE DASHBOARD -->
                <ScrollPane fx:id="financeDashboardView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="25" styleClass="content-padding">

                        <!-- Header -->
                        <VBox spacing="5">
                            <Label text="Finance Dashboard" styleClass="header-title"/>
                            <Label text="Monitor fees and payment records" styleClass="header-subtitle"/>
                        </VBox>

                        <!-- Financial Summary Cards -->
                        <HBox spacing="20">
                            <!-- Total Semester Fees Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="💵" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Semester Fees" styleClass="card-label"/>
                                        <Label fx:id="totalSemesterFeesLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Expected revenue for current semester" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Amount Paid Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label text="✅" styleClass="card-icon-bg-green"/>
                                    <VBox spacing="5">
                                        <Label text="Amount Paid" styleClass="card-label"/>
                                        <Label fx:id="amountPaidLabel" text="GH₵ 0.00" styleClass="card-value-green"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="collectionPercentageLabel" text="0%" styleClass="percentage-label"/>
                                        <Label text="collected" styleClass="card-footer-text"/>
                                    </HBox>
                                    <ProgressBar fx:id="collectionProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                                </VBox>
                            </VBox>

                            <!-- Outstanding Balance Card -->
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="⏳" styleClass="card-icon-bg-red"/>
                                    <VBox spacing="5">
                                        <Label text="Outstanding" styleClass="card-label"/>
                                        <Label fx:id="outstandingBalanceLabel" text="GH₵ 0.00" styleClass="card-value-red"/>
                                    </VBox>
                                </HBox>
                                <Label text="Pending payments" styleClass="card-footer-text"/>
                            </VBox>
                        </HBox>

                        <!-- Student Fee Report Search Section -->
                        <VBox spacing="20" styleClass="stat-card">

                            <Label text="🔍 Student Fee Report" styleClass="section-title"/>
                            <Separator styleClass="content-separator"/>
                            <!-- Search Filters -->
                            <VBox spacing="10" alignment="CENTER">

                                <Label text="Select grade to load students" styleClass="section-title-small"/>

                                <HBox spacing="8" alignment="CENTER_LEFT">

                                    <!-- Student ID Search -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Select student" styleClass="input-label"/>
                                        <ComboBox fx:id="studentSelectionBox"
                                                  promptText="Select Student"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                    <!-- Class/Level Selection -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Class/Level" styleClass="input-label"/>
                                        <ComboBox fx:id="classLevelComboBox"
                                                  promptText="Select Class"
                                                  maxWidth="Infinity"
                                                  onAction="#handleLoadClassStudents"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                    <!-- Semester Selection -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Select semester" styleClass="input-label"/>
                                        <ComboBox fx:id="semesterComboBox"
                                                  promptText="Select Semester"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>
                                <!-- Search Button -->
                                    <Button fx:id="searchFeesHistoryBtn"
                                            text="FETCH FEES RECORDS"
                                            onAction="#handleSearchStudentFees"
                                            maxWidth="Infinity"
                                            styleClass="action-button-primary"/>
                            </VBox>

                            <Separator styleClass="content-separator"/>
                            <!-- Quick Filter Buttons -->
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Quick Filters:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                <Button fx:id="fullyPaidBtn"
                                        text="FULLY PAID"
                                        onAction="#showFullyPaid"
                                        styleClass="filter-pill-green"/>

                                <Button fx:id="partiallyPaidBtn"
                                        text="PARTIAL PAYMENT"
                                        onAction="#showPartialPayment"
                                        styleClass="filter-pill-yellow"/>

                                <Button fx:id="notPaidBtn"
                                        text="NOT PAID"
                                        onAction="#showNotPaid"
                                        styleClass="filter-pill-red"/>
                            </HBox>

                            <!-- Filtered Students Table (Hidden by default) -->
                            <VBox fx:id="filteredStudentsPanel" spacing="15" visible="false" managed="false" styleClass="sub-panel">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="filterTitleLabel" text="Filtered Students" styleClass="section-title-small"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="filteredCountLabel" text="0 students found" style="-fx-text-fill: #64748B;"/>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Filtered Students Table -->
                                <TableView fx:id="filteredStudentsTable" styleClass="modern-table" maxHeight="400">
                                    <columns>
                                        <TableColumn text="Student ID" fx:id="filteredStudentIdColumn" prefWidth="120"/>
                                        <TableColumn text="Student Name" fx:id="filteredStudentNameColumn" prefWidth="180"/>
                                        <TableColumn text="Class" fx:id="filteredStudentClassColumn" prefWidth="100"/>
                                        <TableColumn text="Total Fees" fx:id="filteredTotalFeesColumn" prefWidth="110"/>
                                        <TableColumn text="Amount Paid" fx:id="filteredAmountPaidColumn" prefWidth="120"/>
                                        <TableColumn text="Balance" fx:id="filteredBalanceColumn" prefWidth="110"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No students match this filter" style="-fx-text-fill: #95a5a6;"/>
                                    </placeholder>
                                </TableView>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="CLEAR FILTER"
                                            onAction="#handleClearFilter"
                                            styleClass="action-button-outline"/>
                                </HBox>
                            </VBox>

                            <!-- Student Fee Report Result (Hidden by default) -->
                            <VBox fx:id="feeReportPanel" spacing="20" visible="false" managed="false" styleClass="sub-panel">

                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <StackPane style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-padding: 10;">
                                        <Label text="🎓" style="-fx-font-size: 24px;"/>
                                    </StackPane>
                                    <VBox spacing="5">
                                        <Label fx:id="studentNameLabel" text="Student Name" styleClass="header-title-small"/>
                                        <HBox spacing="10">
                                            <Label fx:id="studentIdDisplayLabel" text="ID: 102030" styleClass="tag-label"/>
                                            <Label fx:id="studentClassLabel" text="Form 1A" styleClass="tag-label"/>
                                            <Label fx:id="studentSemesterLabel" text="1st Semester" styleClass="tag-label"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <!-- Total Fees -->
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Total Fees" styleClass="input-label"/>
                                        <Label fx:id="studentTotalFeesLabel" text="GH₵ 0.00" styleClass="value-large"/>
                                    </VBox>

                                    <!-- Amount Paid -->
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Amount Paid" styleClass="input-label"/>
                                        <Label fx:id="studentAmountPaidLabel" text="GH₵ 0.00" styleClass="value-large-green"/>
                                    </VBox>

                                    <!-- Balance -->
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Balance" styleClass="input-label"/>
                                        <Label fx:id="studentBalanceLabel" text="GH₵ 0.00" styleClass="value-large-red"/>
                                    </VBox>
                                </HBox>

                                <!-- Progress Bar -->
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Payment Progress" styleClass="input-label"/>
                                        <Label fx:id="studentPaymentPercentageLabel" text="0%" style="-fx-text-fill: #10B981; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <ProgressBar fx:id="studentPaymentProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                                </VBox>

                                <!-- Payment History Table -->
                                <VBox spacing="10">
                                    <Label text="Payment History" styleClass="section-title-small"/>
                                    <TableView fx:id="paymentHistoryTable" styleClass="modern-table" maxHeight="200">
                                        <columns>
                                            <TableColumn text="Date" fx:id="paymentDateColumn" prefWidth="120"/>
                                            <TableColumn text="Amount Paid" fx:id="paymentAmountColumn" prefWidth="120"/>
                                            <TableColumn text="Payer" fx:id="paymentPersonColumn" prefWidth="130"/>
                                            <TableColumn text="Contact" fx:id="paymentPersonContactColumn" prefWidth="120"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="No payment records found" style="-fx-text-fill: #94A3B8;"/>
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- All Students Fee Summary Table -->
                        <VBox spacing="20" styleClass="stat-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Fee Summary by Class" styleClass="section-title"/>
                            </HBox>
                            <Separator styleClass="content-separator"/>

                            <!-- Summary Table -->
                            <TableView fx:id="classSummaryTable" styleClass="modern-table">
                                <columns>
                                    <TableColumn text="Grade/Level" fx:id="summaryClassColumn" prefWidth="150"/>
                                    <TableColumn text="Students" fx:id="summaryStudentCountColumn" prefWidth="120"/>
                                    <TableColumn text="Expected Fees" fx:id="summaryExpectedFeesColumn" prefWidth="140"/>
                                    <TableColumn text="Paid" fx:id="summaryAmountPaidColumn" prefWidth="140"/>
                                    <TableColumn text="Outstanding" fx:id="summaryOutstandingColumn" prefWidth="140"/>
                                </columns>
                                <placeholder>
                                    <Label text="No data available" style="-fx-text-fill: #95a5a6;"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                    </VBox>
                </ScrollPane>



                <!--
                PRINCIPAL STUDENT DASHBOARD
                -->
                <ScrollPane fx:id="studentDashboardView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="30" styleClass="content-padding">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5">
                                <Label text="Student Dashboard" styleClass="header-title"/>
                                <Label text="Manage students, enrollments, and view academic records" styleClass="header-subtitle"/>
                            </VBox>
                        </HBox>

                        <!-- Quick Stats & Actions Row -->
                        <FlowPane hgap="20" vgap="20" prefWrapLength="1100">
                        <!-- Total Students Card -->
                            <VBox styleClass="stat-card"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="🎓" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Students" styleClass="card-label"/>
                                        <Label fx:id="totalStudentsCountLabel" text="0" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Enrolled students" styleClass="card-footer-text"/>
                            </VBox>

                            <!-- Add Student Button Card -->
                            <VBox styleClass="card-add-student"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350"
                                  alignment="CENTER"
                                  spacing="10"
                                  onMouseClicked="#openAddStudentPage">
                                <Label text="➕" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                                <Label text="MANAGE STUDENTS" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Click to enroll or update student info" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>

                            <!-- View Class Results Card -->
                            <VBox styleClass="card-add-student"
                                  minWidth="260"
                                  prefWidth="300"
                                  maxWidth="350"
                                  alignment="CENTER"
                                  spacing="10"
                                  onMouseClicked="#openClassResultsView">

                                <Label text="View Entire Class Results" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label text="Click to Open Results Page" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>

                        </FlowPane>

                        <!-- Search Student Results Section -->
                        <VBox spacing="20" styleClass="stat-card">

                            <Label text="📈 Student Academic Results" styleClass="section-title"/>
                            <Separator styleClass="content-separator"/>

                            <!-- Search Filters -->
                            <VBox spacing="10" alignment="CENTER_LEFT">

                                <Label text="Select grade to fetch students" styleClass="section-title-small"/>

                                <HBox spacing="8" alignment="CENTER_LEFT">

                                    <!-- Student Selection -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Student ID" styleClass="input-label"/>
                                        <ComboBox fx:id="results_StudentSelectionBox"
                                                  maxWidth="Infinity"
                                                   promptText="Select student"
                                                   styleClass="modern-input"/>
                                    </VBox>

                                    <!-- Semester Selection -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Semester" styleClass="input-label"/>
                                        <ComboBox fx:id="resultsClassComboBox"
                                                  promptText="Select class"
                                                  onAction="#handleFetchStudents"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                    <!-- Class Selection -->
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Semester" styleClass="input-label"/>
                                        <ComboBox fx:id="resultsSemesterComboBox"
                                                  promptText="Select"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>
                                </HBox>

                                <!-- Search Button -->
                                <VBox spacing="8" alignment="CENTER_LEFT">
                                    <Button fx:id="getResultsBtn"
                                            text="FETCH RESULT"
                                            onAction="#handleSearchResults"
                                            maxWidth="Infinity"
                                            styleClass="action-button-primary"/>
                                </VBox>
                            </VBox>

                            <!-- Results Display Panel (Hidden by default) -->
                            <VBox fx:id="resultsDisplayPanel" spacing="25" visible="false" managed="false" styleClass="sub-panel">
                                <!-- Results Header -->
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="📊" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label fx:id="resultsStudentNameLabel" text="Student Name" styleClass="header-title-small"/>
                                        <HBox spacing="10">
                                            <Label fx:id="resultsStudentIdLabel" text="ID: STU001" styleClass="tag-label"/>
                                            <Label fx:id="resultsClassLabel" text="Form 1A" styleClass="tag-label"/>
                                            <Label fx:id="resultsSemesterLabel" text="1st Semester" styleClass="tag-label"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Overall Performance Summary -->
                                <HBox spacing="20">
                                    <VBox styleClass="score-box" HBox.hgrow="ALWAYS">
                                        <Label text="Total Score" styleClass="score-label"/>
                                        <Label fx:id="totalScoreLabel" text="0" styleClass="score-value-dark"/>
                                    </VBox>

                                    <VBox styleClass="score-box" HBox.hgrow="ALWAYS">
                                        <Label text="Average" styleClass="score-label"/>
                                        <Label fx:id="averageScoreLabel" text="0%" styleClass="score-value-green"/>
                                    </VBox>

                                    <VBox styleClass="score-box" HBox.hgrow="ALWAYS">
                                        <Label text="Position" styleClass="score-label"/>
                                        <Label fx:id="positionLabel" text="1st" styleClass="score-value-blue"/>
                                    </VBox>
                                </HBox>

                                <!-- Subjects Results Table -->
                                <VBox spacing="10">
                                    <Label text="Subject Breakdown" styleClass="section-title-small"/>
                                    <TableView fx:id="subjectResultsTable" styleClass="modern-table" maxHeight="300">
                                        <columns>
                                            <TableColumn fx:id="subjectNameColumn" text="SUBJECT" prefWidth="150"/>
                                            <TableColumn fx:id="ex1Column" text="EX 1" prefWidth="100"/>
                                            <TableColumn fx:id="classTestColumn" text="CLASS TEST" prefWidth="100"/>
                                            <TableColumn fx:id="ex2Column" text="EX 2" prefWidth="100"/>
                                            <TableColumn fx:id="projectScoreColumn" text="PROJECT" prefWidth="100"/>
                                            <TableColumn fx:id="examScoreColumn" text="EXAM SCORE" prefWidth="120"/>
                                            <TableColumn fx:id="classScoreColumn" text="CLASS (50%)" prefWidth="120"/>
                                            <TableColumn fx:id="calExamScoreColumn" text="EXAM (50%)" prefWidth="100"/>
                                            <TableColumn fx:id="subTotalScoreColumn" text="TOTAL SCORE" prefWidth="100"/>
                                            <TableColumn fx:id="subjectGradeColumn" text="GRADE" prefWidth="100"/>
                                            <TableColumn fx:id="subjectRemarkColumn" text="REMARK" prefWidth="150"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="No results available for this selection" style="-fx-text-fill: #94A3B8;"/>
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>



                <!--
                PRINCIPAL STAFF DASHBOARD
                -->
                <ScrollPane fx:id="staffDashboardView"
                            visible="false" managed="false"
                            fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox spacing="25" styleClass="content-padding">

                        <StackPane>

                            <VBox fx:id="staffManagementContainer"
                                  spacing="30" styleClass="panel-card" maxWidth="1000">

                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <VBox spacing="5">
                                        <Label text="Staff Dashboard" styleClass="header-title"/>
                                        <Label text="Manage staff members, class assignments, and subjects" styleClass="header-subtitle"/>
                                    </VBox>
                                </HBox>

                                <!-- Quick Actions Row -->
                                <HBox spacing="20">
                                    <!-- Total Staff Card -->
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="20">
                                            <Label text="👥" styleClass="card-icon-bg-blue"/>
                                            <VBox spacing="5">
                                                <Label text="Total Staff" styleClass="card-label"/>
                                                <Label fx:id="totalStaffCountLabel" text="0" styleClass="card-value"/>
                                            </VBox>
                                        </HBox>
                                        <Label text="Active staff members" styleClass="card-footer-text"/>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="20">
                                            <Label text="👥" styleClass="card-icon-bg-blue"/>
                                            <VBox spacing="5">
                                                <Label text="Teaching Staff" styleClass="card-label"/>
                                                <Label fx:id="teachingStaffCountLabel" text="0" styleClass="card-value"/>
                                            </VBox>
                                        </HBox>
                                        <Label text="Active teaching staffs" styleClass="card-footer-text"/>
                                    </VBox>
                                </HBox>

                                <!-- All Staff List Section -->
                                <VBox spacing="20" styleClass="stat-card">

                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="📋 Current Staff List" styleClass="section-title"/>
                                    </HBox>

                                    <Separator styleClass="content-separator"/>

                                    <TableView fx:id="allStaffTable" styleClass="modern-table">
                                        <columns>
                                            <TableColumn text="ID" fx:id="staffIdColumn" prefWidth="120"/>
                                            <TableColumn text="NAME" fx:id="staffNameColumn" prefWidth="250"/>
                                            <TableColumn text="STAFF ROLE" fx:id="staffRoleColumn" prefWidth="250"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="No staff members found" style="-fx-text-fill: #94A3B8;"/>
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </VBox>

                            <!-- Staff Details Panel (Hidden by default) -->
                            <VBox fx:id="staffDetailsPanel"
                                  spacing="20" visible="false"
                                  managed="false" styleClass="panel-card" maxWidth="800">

                                <VBox spacing="8" alignment="CENTER_LEFT">
                                    <Button text="BACK"
                                            onAction="#backToStaffDashboard"
                                            styleClass="back-nav-button"/>
                                </VBox>

                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Staff Name" styleClass="input-label"/>
                                        <Label fx:id="staffFullNameLabel" styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Staff ID" styleClass="section-title"/>
                                        <Label fx:id="staffIdLabel" styleClass="section-title"/>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Editable Staff Information -->
                                <VBox spacing="15" alignment="CENTER">

                                    <HBox spacing="10" alignment="CENTER_LEFT">

                                        <!-- First Name -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="First Name *" styleClass="input-label"/>
                                            <TextField fx:id="editFirstNameField" styleClass="modern-input"/>
                                        </VBox>

                                        <!-- Last Name -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Last Name *" styleClass="input-label"/>
                                            <TextField fx:id="editLastNameField" styleClass="modern-input"/>
                                        </VBox>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">

                                        <!-- Email -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Email *" styleClass="input-label"/>
                                            <TextField fx:id="editEmailField" styleClass="modern-input"/>
                                        </VBox>

                                        <!-- Phone Number -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Phone Number *" styleClass="input-label"/>
                                            <TextField fx:id="editPhoneField" styleClass="modern-input"/>
                                        </VBox>
                                    </HBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">

                                        <!-- Date of Birth -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Date of Birth *" styleClass="input-label"/>
                                            <DatePicker fx:id="editDateOfBirthPicker" maxWidth="Infinity" styleClass="modern-date-picker"/>
                                        </VBox>

                                        <!-- Gender -->
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="Gender *" styleClass="input-label"/>
                                            <ComboBox fx:id="editGenderComboBox"
                                                      promptText="Select gender"
                                                      styleClass="modern-combo"
                                                      maxWidth="300"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Role -->
                                    <VBox spacing="5" alignment="CENTER">
                                        <Label text="Select Role(s) *" styleClass="input-label"/>
                                        <HBox spacing="5" alignment="CENTER_LEFT">
                                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER">
                                                <Label text="PRINCIPAL" styleClass="section-header-blue"/>
                                                <CheckBox fx:id="role1"
                                                          styleClass="modern-checkbox"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER">
                                                <Label text="ACCOUNTANT" styleClass="section-header-blue"/>
                                                <CheckBox fx:id="role2"
                                                          styleClass="modern-checkbox"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER">
                                                <Label text="TEACHING_STAFF" styleClass="section-header-blue"/>
                                                <CheckBox fx:id="role3"
                                                          styleClass="modern-checkbox"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER">
                                                <Label text="GENERAL_STAFF" styleClass="section-header-blue"/>
                                                <CheckBox fx:id="role4"
                                                          styleClass="modern-checkbox"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="CENTER">
                                                <Label text="ADMINISTRATOR" styleClass="section-header-blue"/>
                                                <CheckBox fx:id="role5"
                                                          styleClass="modern-checkbox"/>
                                            </VBox>
                                        </HBox>

                                        <Separator styleClass="content-separator"/>

                                        <VBox spacing="5" alignment="CENTER_LEFT">
                                            <Label text="Status *" styleClass="input-label"/>
                                            <ComboBox fx:id="editStatusComboBox"
                                                      maxWidth="300"
                                                      styleClass="modern-combo"/>
                                        </VBox>
                                    </VBox>

                                    <VBox alignment="CENTER_RIGHT">

                                        <Button fx:id="updateStaffBtn"
                                                text="SAVE CHANGES"
                                                onAction="#handleUpdateStaffInfo"
                                                styleClass="action-button-primary"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                        </StackPane>
                    </VBox>
                </ScrollPane>

                <!-- ADD NEW STUDENT PAGE -->
                <ScrollPane fx:id="addNewStudentView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">

                    <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #DBEAFE;">
                                <Label text="🎓" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="STUDENT INFORMATION MANAGEMENT" styleClass="header-title"/>
                            <Label text="Add or Update student information" styleClass="header-subtitle"/>
                        </VBox>

                        <!-- 🔘 TOGGLE BUTTONS -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="addStudentToggleBtn"
                                    text="ADD STUDENT"
                                    onAction="#showAddStudentCard"
                                    styleClass="action-button-primary"/>

                            <Button fx:id="updateStudentToggleBtn"
                                    text="UPDATE STUDENT INFO"
                                    onAction="#showUpdateInfoCard"
                                    styleClass="action-button-primary"/>
                        </HBox>

                        <StackPane fx:id="studentInfoCardContainer" maxWidth="700">

                            <!-- ADD STUDENT CARD -->
                            <VBox fx:id="addStudentCard" spacing="25" styleClass="panel-card" maxWidth="700">

                                <VBox spacing="15">
                                    <Label text="Personal Information" styleClass="section-header-blue"/>

                                    <HBox spacing="15">
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <Label text="First Name *" styleClass="input-label"/>
                                            <TextField fx:id="firstNameField" promptText="e.g. John" styleClass="modern-input"/>
                                        </VBox>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <Label text="Last Name *" styleClass="input-label"/>
                                            <TextField fx:id="lastNameField" promptText="e.g. Doe" styleClass="modern-input"/>
                                        </VBox>
                                    </HBox>

                                    <HBox spacing="15">
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <Label text="Gender *" styleClass="input-label"/>
                                            <ComboBox fx:id="genderComboBox" promptText="Select" maxWidth="Infinity" styleClass="modern-combo"/>
                                        </VBox>
                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                            <Label text="Date of Birth *" styleClass="input-label"/>
                                            <DatePicker fx:id="dateOfBirthPicker" promptText="MM/DD/YYYY" maxWidth="Infinity" styleClass="modern-date-picker"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="8">
                                        <Label text="Home Town *" styleClass="input-label"/>
                                        <TextField fx:id="homeTownField" promptText="Enter student's home town" styleClass="modern-input"/>
                                    </VBox>
                                </VBox>

                                <Separator styleClass="content-separator"/>

                                <VBox spacing="15">
                                    <Label text="Parent/Guardian Information" styleClass="section-header-blue"/>

                                    <VBox spacing="8">
                                        <Label text="Parent/Guardian Name *" styleClass="input-label"/>
                                        <TextField fx:id="parentNameField" promptText="Full name of primary contact" styleClass="modern-input"/>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label text="Parent Phone Number *" styleClass="input-label"/>
                                        <TextField fx:id="parentPhoneField" promptText="0XXXXXXXXX" styleClass="modern-input"/>
                                    </VBox>
                                </VBox>

                                <Separator styleClass="content-separator"/>

                                <VBox spacing="15">
                                    <Label text="Class Information" styleClass="section-header-blue"/>
                                    <VBox spacing="8">
                                        <Label text="Assigned Class/Level *" styleClass="input-label"/>
                                        <ComboBox fx:id="classComboBox" promptText="Select Grade" maxWidth="Infinity" styleClass="modern-combo"/>
                                        <Label text="💡 Ensure the class has available capacity before enrolling." styleClass="login-footer-label"/>
                                    </VBox>
                                </VBox>

                                <Separator styleClass="content-separator"/>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button fx:id="saveAndClearBtn"
                                            text="Save Student"
                                            onAction="#handleSaveAndClear"
                                            styleClass="action-button-mint"
                                            HBox.hgrow="ALWAYS" />
                                </HBox>

                                <VBox spacing="8" styleClass="alert-panel-info">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="💡" style="-fx-font-size: 14px;"/>
                                        <Label text="Quick Help" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12px;"/>
                                    </HBox>
                                    <Label text="• Student ID will be generated automatically upon successful save." styleClass="login-footer-label" wrapText="true"/>
                                </VBox>
                            </VBox>

                            <!-- UPDATE STUDENT INFO CARD -->
                            <VBox fx:id="updateStudentInfoCard" spacing="25" styleClass="panel-card" maxWidth="700">

                                <VBox fx:id="studentSearchFieldBox" spacing="10" alignment="CENTER_LEFT">

                                    <HBox spacing="10">
                                        <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="300">
                                            <Label text="Select student"
                                                   styleClass="input-label"/>
                                            <ComboBox fx:id="studentSearchComboBox"
                                                      maxWidth="Infinity"
                                                      promptText="select student"
                                                      styleClass="modern-combo"/>
                                        </VBox>

                                        <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="300">
                                            <Label text="Select Grade"
                                                   styleClass="input-label"/>
                                            <ComboBox fx:id="studentSearchClassBox"
                                                      promptText="select grade"
                                                      maxWidth="Infinity"
                                                      onAction="#fetchGradeStudents"
                                                      styleClass="modern-input"/>
                                        </VBox>
                                    </HBox>

                                    <VBox alignment="BOTTOM_RIGHT">
                                        <Button fx:id="findStudentBtn"
                                                text="FETCH STUDENT DATA"
                                                onAction="#handleFindStudent"
                                                styleClass="action-button-primary"/>
                                    </VBox>
                                </VBox>

                                <VBox fx:id="studentDetailsPanel" spacing="15">

                                    <VBox spacing="10" alignment="CENTER_LEFT" styleClass="sub-panel">
                                        <HBox spacing="8" >
                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="STUDENT ID:" styleClass="input-label"/>
                                                <Label fx:id="studentIdLabel" text=" " styleClass="section-title-small"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="STUDENT STATUS:" styleClass="input-label"/>
                                                <Label fx:id="studentStatusLabel" text=" " styleClass="section-title-small"/>
                                            </VBox>

                                        </HBox>

                                        <Label text="GRADE NAME:" styleClass="input-label"/>
                                        <Label fx:id="updateGradeNameLabel" text=" " styleClass="section-title-small"/>
                                    </VBox>

                                    <Separator styleClass="content-separator"/>

                                    <VBox spacing="10" alignment="CENTER_LEFT" styleClass="sub-panel">
                                        <Label text="Personal Information" styleClass="section-header-blue"/>

                                        <Separator styleClass="content-separator"/>

                                        <Label text="GRADE NAME:" styleClass="input-label"/>
                                        <Label fx:id="updateStudentNameLabel" text=" " styleClass="section-title-small"/>

                                        <HBox spacing="15">
                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="Gender *" styleClass="input-label"/>
                                                <Label fx:id="updateGenderComboBox"
                                                       maxWidth="300"
                                                       styleClass="section-title-small"/>
                                            </VBox>
                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="Date of Birth *" styleClass="input-label"/>
                                                <Label fx:id="updateDateOfBirthPicker"
                                                       maxWidth="300"
                                                       styleClass="section-title-small"/>
                                            </VBox>
                                        </HBox>

                                        <VBox spacing="8">
                                            <Label text="Home Town *" styleClass="input-label"/>
                                            <Label fx:id="updateHomeTownField"
                                                   styleClass="section-title-small"/>
                                        </VBox>
                                    </VBox>
                                    <Separator styleClass="content-separator"/>

                                    <VBox spacing="10" alignment="CENTER_LEFT" styleClass="sub-panel">

                                        <Label text="Parent/Guardian Information" styleClass="section-header-blue"/>

                                        <HBox spacing="10">

                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="Parent/Guardian Name *" styleClass="input-label"/>
                                                <Label fx:id="updateParentNameField"
                                                       styleClass="section-title-small"/>
                                            </VBox>

                                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                <Label text="Parent Phone Number *" styleClass="input-label"/>
                                                <Label fx:id="updateParentPhoneField"
                                                       styleClass="section-title-small"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>

                        </StackPane>
                    </VBox>
                </ScrollPane>

                <!-- MANAGE RESULTS PAGE -->
                <ScrollPane fx:id="manageResultsView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">

                    <VBox spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #FDF2F8;">
                                <Label text="📝" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="ACADEMIC REPORTS MANAGEMENT" styleClass="header-title"/>
                            <Label text="View academic results and move passed students" styleClass="header-subtitle"/>
                        </VBox>

                        <VBox spacing="25" styleClass="panel-card" maxWidth="1000">

                            <Label text="Semester Selection" styleClass="section-header-blue"/>

                            <VBox spacing="15" alignment="CENTER_LEFT">

                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Select Term *" styleClass="input-label"/>
                                        <ComboBox fx:id="classResultsSemesterComboBox"
                                                  promptText="Select Semester"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                    <VBox spacing="8" prefWidth="300">
                                        <Label text="Select Grade *" styleClass="input-label"/>
                                        <ComboBox fx:id="classResultsGradeComboBox"
                                                  promptText="Select Semester"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                </HBox>

                                <HBox spacing="15" alignment="BOTTOM_RIGHT">

                                    <Button text="CANCEL"
                                            onAction="#backToDashboard"
                                            styleClass="action-button-red"/>


                                    <Button fx:id="loadClassResultsBtn"
                                            text="FETCH RESULTS"
                                            onAction="#handleLoadClassResults"
                                            styleClass="action-button-primary"/>

                                </HBox>

                            </VBox>

                            <HBox fx:id="resultsInfoBox" spacing="15" alignment="CENTER_LEFT" visible="false" managed="false"
                                  styleClass="alert-panel-info">
                                <Label text="📚" styleClass="sidebar-logo-bg"/>
                                <VBox spacing="2">
                                    <Label fx:id="gradeNameLabel" text=" " styleClass="section-title"/>
                                    <Label fx:id="semesterNameLabel" text=" " styleClass="section-title"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="View Results Below" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            </HBox>

                            <VBox fx:id="classResultsTableContainer" spacing="20" visible="false" managed="false">
                                <Separator styleClass="content-separator"/>

                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="5">
                                        <Label text="Student Ledger" styleClass="section-title"/>
                                        <Label text="Click row to view detailed result below the table" styleClass="login-footer-label"/>
                                    </VBox>
                                </HBox>

                                <TableView fx:id="classResultsTable"
                                           editable="true"
                                           styleClass="modern-table"
                                           prefHeight="200">

                                    <columns>
                                        <TableColumn text="STUD ID" fx:id="studentResultIdColumn" prefWidth="150" />
                                        <TableColumn text="STUD NAME" fx:id="studentResultNameColumn" prefWidth="300" />
                                        <TableColumn text="GRADE" fx:id="classNameColumn" prefWidth="180" />
                                        <TableColumn text="SEMESTER" fx:id="semesterNameColumn" prefWidth="180"/>
                                        <TableColumn text="TOTAL SCORE" fx:id="totalScoreColumn" prefWidth="180"/>
                                        <TableColumn text="AVG SCORE" fx:id="averageScoreColumn" prefWidth="180"/>
                                        <TableColumn text="POSITION" fx:id="positionColumn" prefWidth="180"/>
                                    </columns>
                                </TableView>

                                <VBox fx:id="studentDetailsBox" visible="false" managed="false" spacing="15" styleClass="sub-panel">

                                    <Label text="📊 Subject Breakdown" styleClass="section-title-small"/>

                                    <TableView fx:id="subjectBreakdownTable" styleClass="modern-table" maxHeight="250">
                                        <columns>
                                            <TableColumn fx:id="subjectNameCol" text="SUBJECT" prefWidth="250"/>
                                            <TableColumn fx:id="exercise1Col" text="EX 1" prefWidth="100"/>
                                            <TableColumn fx:id="classTestCol" text="CLASS TEST" prefWidth="100"/>
                                            <TableColumn fx:id="exercise2Col" text="EX 2" prefWidth="100"/>
                                            <TableColumn fx:id="projectScoreCol" text="PROJECT" prefWidth="100"/>
                                            <TableColumn fx:id="classScoreCol" text="CLASS (50%)" prefWidth="120"/>
                                            <TableColumn fx:id="examScoreCol" text="EXAM SCORE" prefWidth="120"/>
                                            <TableColumn fx:id="calculatedExamScoreCol" text="EXAM (50%)" prefWidth="100"/>
                                            <TableColumn fx:id="totalCol" text="TOTAL" prefWidth="120"/>
                                            <TableColumn fx:id="gradeCol" text="GRADE" prefWidth="120"/>
                                            <TableColumn fx:id="remarkCol" text="REMARK" prefWidth="200"/>
                                        </columns>
                                    </TableView>

                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- LOADING OVERLAY -->
                <VBox fx:id="loadingOverlay"
                      alignment="CENTER"
                      spacing="15"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(0,0,0,0.35);">

                    <ProgressIndicator fx:id="loadingSpinner" />

                    <Label text="Loading dashboard..."
                           style="-fx-text-fill: white; -fx-font-size: 14;" />
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

</StackPane>