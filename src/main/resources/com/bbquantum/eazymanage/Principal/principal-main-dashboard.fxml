                        </VBox>

                        <!-- 🔘 TOGGLE BUTTONS -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="addSemesterToggleBtn"
                                    text="ADD SEMESTER"
                                    onAction="#showAddSemesterCard"
                                    styleClass="action-button-primary"/>

                            <Button fx:id="updateSemesterToggleBtn"
                                    text="UPDATE SEMESTER INFO"
                                    onAction="#showUpdateSemesterCard"
                                    styleClass="action-button-primary"/>
                        </HBox>

                        <StackPane maxWidth="700">

                            <!-- Add semster Card -->
                            <VBox fx:id="addSemesterCard" spacing="25" styleClass="panel-card" maxWidth="700">

                                <Label text="Semester Details" styleClass="section-header-blue"/>

                                <VBox spacing="10">
                                    <Label text="Term Name *" styleClass="input-label"/>
                                    <TextField fx:id="semesterNameField" promptText="e.g. First_Term" styleClass="modern-input"/>
                                </VBox>

                                <HBox spacing="15">
                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                        <Label text="Start Date *" styleClass="input-label"/>
                                        <DatePicker fx:id="startDatePicker" styleClass="modern-date-picker"/>
                                    </VBox>

                                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                                        <Label text="End Date *" styleClass="input-label"/>
                                        <DatePicker fx:id="endDatePicker" styleClass="modern-date-picker"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="10">
                                    <Label text="Academic Year *" styleClass="input-label"/>
                                    <TextField fx:id="academicYearField" promptText="e.g. 2024/2025" styleClass="modern-input"/>
                                </VBox>

                                <Separator styleClass="content-separator"/>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="CANCEL"
                                            onAction="#backToDashboard"
                                            styleClass="action-button-red"/>

                                    <Button fx:id="saveSemesterBtn"
                                            text="SAVE SEMESTER"
                                            onAction="#handleSaveSemester"
                                            styleClass="action-button-primary"/>
                                </HBox>

                            </VBox>

                            <VBox fx:id="updateSemesterInfoCard"
                                  spacing="25"
                                  styleClass="panel-card"
                                  visible="false"
                                  managed="false"
                                  maxWidth="700">

                                <VBox fx:id="semesterSearchPanel" spacing="8" maxWidth="700">
                                    <Label text="Select a semester to update info" styleClass="input-label"/>

                                    <HBox spacing="50" alignment="CENTER_LEFT" >
                                        <ComboBox fx:id="updateSemesterInfoComboBox"
                                                  maxWidth="700"
                                                  promptText="Select semester"
                                                  styleClass="modern-combo"/>

                                        <Button fx:id="findSemesterBtn"
                                                text="FETCH INFO"
                                                onAction="#handleSearchSemesterInfo"
                                                styleClass="action-button-primary"/>
                                    </HBox>
                                </VBox>

                                <VBox fx:id="semesterInfoPanel" spacing="25" maxWidth="700" visible="false" managed="false">

                                    <Label text="Semester Details" styleClass="section-header-blue"/>

                                    <VBox spacing="10">
                                        <Label text="Term Name *" styleClass="input-label"/>
                                        <TextField fx:id="updateSemesterNameField" promptText="e.g. First_Term" styleClass="modern-input"/>
                                    </VBox>

                                    <HBox spacing="15">
                                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                                            <Label text="Start Date *" styleClass="input-label"/>
                                            <DatePicker fx:id="updateStartDatePicker" styleClass="modern-date-picker"/>
                                        </VBox>

                                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                                            <Label text="End Date *" styleClass="input-label"/>
                                            <DatePicker fx:id="updateEndDatePicker" styleClass="modern-date-picker"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="10">
                                        <Label text="Academic Year *" styleClass="input-label"/>
                                        <TextField fx:id="updateAcademicYearField" promptText="e.g. 2024/2025" styleClass="modern-input"/>
                                    </VBox>

                                    <Separator styleClass="content-separator"/>

                                    <HBox spacing="15" alignment="CENTER_RIGHT">
                                        <Button text="CANCEL"
                                                onAction="#backToDashboard"
                                                styleClass="action-button-red"/>

                                        <Button fx:id="updateSemesterBtn"
                                                text="SAVE CHANGES"
                                                onAction="#handleUpdateSemesterInfo"
                                                styleClass="action-button-primary"/>
                                    </HBox>

                                </VBox>

                                </VBox>

                        </StackPane>
                    </VBox>
                </ScrollPane>

                <!-- ADD GRADES PAGE -->
                <ScrollPane fx:id="addGradesView"
                            visible="false"
                            managed="false"
                            fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox spacing="30" styleClass="content-padding" alignment="TOP_CENTER">

                        <!-- Header -->
                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #ECFEFF;">
                                <Label text=" " style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="ADD NEW GRADES CRITERIA" styleClass="header-title"/>
                            <Label text="Create and configure a new grades criteria" styleClass="header-subtitle"/>
                        </VBox>

                        <!-- Card -->
                        <VBox spacing="25" styleClass="panel-card" maxWidth="700">

                            <Label text="Grade Details" styleClass="section-header-blue"/>

                            <VBox spacing="10">
                                <Label text="Grade Representation" styleClass="input-label"/>
                                <TextField fx:id="gradeCriteriaField" promptText="A, B, C" styleClass="modern-input"/>
                            </VBox>

                            <HBox spacing="15">
                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <Label text="Lower Limit" styleClass="input-label"/>
                                    <TextField fx:id="lowerRangeField" promptText="80" styleClass="modern-date-picker"/>
                                </VBox>

                                <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <Label text="Upper Limit" styleClass="input-label"/>
                                    <TextField fx:id="upperRangeField" promptText="100" styleClass="modern-date-picker"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="10">
                                <Label text="Grade Remarks" styleClass="input-label"/>
                                <TextField fx:id="gradeRemarksField" promptText="Excellent" styleClass="modern-input"/>
                            </VBox>

                            <Separator styleClass="content-separator"/>

                            <HBox spacing="15" alignment="CENTER_RIGHT">
                                <Button text="CANCEL"
                                        onAction="#backToDashboard"
                                        styleClass="action-button-red"/>

                                <Button fx:id="saveGradeBtn"
                                        text="ADD GRADE CRITERIA"
                                        onAction="#handleSaveGrade"
                                        styleClass="action-button-primary"/>
                            </HBox>

                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- ADD CLASS PAGE -->
                <ScrollPane fx:id="addNewClassView"
                            visible="false"
                            managed="false"
                            fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox spacing="30" alignment="TOP_CENTER" styleClass="content-padding">

                        <!-- Header -->
                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #DBEAFE;">
                                <Label text="🏫" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="MANAGE CLASSES" styleClass="header-title"/>
                            <Label text="Add  or update exiting class info." styleClass="header-subtitle"/>
                        </VBox>

                        <!-- 🔘 TOGGLE BUTTONS -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="addClassToggleBtn"
                                    text="ADD SUBJECT"
                                    onAction="#showAddClassCard"
                                    styleClass="action-button-primary"/>

                            <Button fx:id="updateClassInfoToggleBtn"
                                    text="UPDATE CLASS INFO"
                                    onAction="#showUpdateClassInfoCard"
                                    styleClass="action-button-primary"/>
                        </HBox>

                        <StackPane fx:id="classCardContainer"
                                   maxWidth="700">

                            <!-- Add new class page -->
                            <VBox fx:id="addClassCard" spacing="25" maxWidth="700" styleClass="panel-card">

                                <Label text="CLASS INFORMATION" styleClass="section-header-blue"/>

                                <!-- Class Name -->
                                <VBox spacing="8">
                                    <Label text="Class Name *" styleClass="input-label"/>
                                    <TextField fx:id="addClassNameField"
                                               promptText="e.g. Grade_1, JHS_2, Form_3A"
                                               styleClass="modern-input"/>
                                </VBox>

                                <!-- Instructor -->
                                <VBox spacing="8">
                                    <Label text="Assign Instructor *" styleClass="input-label"/>
                                    <ComboBox fx:id="addClassStaffComboBox"
                                              promptText="Select Instructor"
                                              maxWidth="Infinity"
                                              styleClass="modern-combo"/>
                                    <Label text="💡 Only active teaching staff will appear here"
                                           styleClass="login-footer-label"/>
                                </VBox>

                                <Separator styleClass="content-separator"/>

                                <!-- Buttons -->
                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="CANCEL"
                                            onAction="#backToDashboard"
                                            styleClass="action-button-red"/>

                                    <Button fx:id="saveClassBtn"
                                            text="ADD CLASS"
                                            onAction="#handleAddClass"
                                            styleClass="action-button-primary"/>
                                </HBox>

                            </VBox>


                            <!-- Update class card -->
                            <VBox fx:id="updateClassInfoCard" spacing="25" maxWidth="700" styleClass="panel-card">

                                <VBox fx:id="updateClassSearchArea" spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Enter Class Name or class ID" styleClass="input-label"/>
                                    <TextField fx:id="updateClassSearchField"
                                               promptText="e.g. Grade_1 or LV******"
                                               styleClass="modern-input"/>

                                    <VBox spacing="8" alignment="BOTTOM_RIGHT">
                                        <Button fx:id="searchClassBtn"
                                                text="FIND CLASS"
                                                onAction="#handleFindClass"
                                                styleClass="action-button-primary"/>
                                    </VBox>
                                </VBox>

                                <VBox fx:id="updateClassInfoDisplayArea" visible="false" managed="false" spacing="25">

                                    <Label text="CLASS INFORMATION" styleClass="section-header-blue"/>

                                    <Separator styleClass="content-separator"/>

                                    <!-- Class Name -->
                                    <VBox spacing="8">
                                        <Label text="Class Name *" styleClass="input-label"/>
                                        <TextField fx:id="updateClassInfoNameField"
                                                   promptText="e.g. Grade_1, JHS_2, Form_3A"
                                                   styleClass="modern-input"/>
                                    </VBox>

                                    <!-- Instructor -->
                                    <VBox spacing="8">
                                        <Label text="Assign Instructor *" styleClass="input-label"/>
                                        <ComboBox fx:id="updateClassInfoStaffComboBox"
                                                  promptText="Select Instructor"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                        <Label text="💡 Only active teaching staff will appear here"
                                               styleClass="login-footer-label"/>
                                    </VBox>

                                    <Separator styleClass="content-separator"/>

                                    <!-- Buttons -->
                                    <HBox spacing="15" alignment="CENTER_RIGHT">
                                        <Button text="CANCEL"
                                                onAction="#backToDashboard"
                                                styleClass="action-button-red"/>

                                        <Button fx:id="updateClassInfoBtn"
                                                text="SAVE CHANGES"
                                                onAction="#handleUpdateClassInfo"
                                                styleClass="action-button-primary"/>
                                    </HBox>

                                </VBox>

                            </VBox>

                        </StackPane>
                    </VBox>
                </ScrollPane>


                <!-- MANAGE RESULTS PAGE -->
                <ScrollPane fx:id="manageResultsView" visible="false" managed="false" fitToWidth="true" styleClass="modern-scroll-pane">

                    <VBox spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #FDF2F8;">
                                <Label text="📝" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="ACADEMIC REPORTS MANAGEMENT" styleClass="header-title"/>
                            <Label text="View academic results and move passed students" styleClass="header-subtitle"/>
                        </VBox>

                        <VBox spacing="25" styleClass="panel-card" maxWidth="1000">

                            <Label text="Semester Selection" styleClass="section-header-blue"/>

                            <VBox spacing="15" alignment="CENTER_LEFT">

                                <HBox spacing="15" alignment="BOTTOM_LEFT">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Select Term *" styleClass="input-label"/>
                                        <ComboBox fx:id="classResultsSemesterComboBox"
                                                  promptText="Select Semester"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Select Grade *" styleClass="input-label"/>
                                        <ComboBox fx:id="classResultsGradeComboBox"
                                                  promptText="Select Semester"
                                                  maxWidth="Infinity"
                                                  styleClass="modern-combo"/>
                                    </VBox>

                                </HBox>

                                <HBox spacing="15" alignment="BOTTOM_RIGHT">

                                    <Button text="CANCEL"
                                            onAction="#backToDashboard"
                                            styleClass="action-button-red"/>


                                    <Button fx:id="loadClassResultsBtn"
                                            text="FETCH RESULTS"
                                            onAction="#handleLoadClassResults"
                                            styleClass="action-button-primary"
                                            style="-fx-padding: 12 30;"/>

                                </HBox>

                            </VBox>

                            <HBox fx:id="resultsInfoBox" spacing="15" alignment="CENTER_LEFT" visible="false" managed="false"
                                  styleClass="alert-panel-info">
                                <Label text="📚" styleClass="sidebar-logo-bg"/>
                                <VBox spacing="2">
                                    <Label fx:id="gradeNameLabel" text=" " styleClass="section-title"/>
                                    <Label fx:id="semesterNameLabel" text=" " styleClass="section-title"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="View Results Below" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            </HBox>

                            <VBox fx:id="classResultsTableContainer" spacing="20" visible="false" managed="false">
                                <Separator styleClass="content-separator"/>

                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="5">
                                        <Label text="Student Ledger" styleClass="section-title"/>
                                        <Label text="Click row to view detailed result below the table" styleClass="login-footer-label"/>
                                    </VBox>
                                </HBox>

                                <TableView fx:id="classResultsTable"
                                           editable="true"
                                           styleClass="modern-table"
                                           prefHeight="200">

                                    <columns>
                                        <TableColumn text="STUD ID" fx:id="studentResultIdColumn" prefWidth="150" />
                                        <TableColumn text="STUD NAME" fx:id="studentResultNameColumn" prefWidth="300" />
                                        <TableColumn text="GRADE" fx:id="classNameColumn" prefWidth="180" />
                                        <TableColumn text="SEMESTER" fx:id="semesterNameColumn" prefWidth="180"/>
                                        <TableColumn text="TOTAL SCORE" fx:id="totalScoreColumn" prefWidth="180"/>
                                        <TableColumn text="AVG SCORE" fx:id="averageScoreColumn" prefWidth="180"/>
                                        <TableColumn text="POSITION" fx:id="positionColumn" prefWidth="180"/>
                                    </columns>
                                </TableView>

                                <VBox fx:id="studentDetailsBox" visible="false" managed="false" spacing="15" styleClass="sub-panel">

                                    <Label text="📊 Subject Breakdown" styleClass="section-title-small"/>

                                    <TableView fx:id="subjectBreakdownTable" styleClass="modern-table" maxHeight="250">
                                        <columns>
                                            <TableColumn fx:id="subjectNameCol" text="SUBJECT" prefWidth="250"/>
                                            <TableColumn fx:id="exercise1Col" text="EX 1" prefWidth="100"/>
                                            <TableColumn fx:id="classTestCol" text="CLASS TEST" prefWidth="100"/>
                                            <TableColumn fx:id="exercise2Col" text="EX 2" prefWidth="100"/>
                                            <TableColumn fx:id="projectScoreCol" text="PROJECT" prefWidth="100"/>
                                            <TableColumn fx:id="classScoreCol" text="CLASS (50%)" prefWidth="120"/>
                                            <TableColumn fx:id="examScoreCol" text="EXAM SCORE" prefWidth="120"/>
                                            <TableColumn fx:id="calculatedExamScoreCol" text="EXAM (50%)" prefWidth="100"/>
                                            <TableColumn fx:id="totalCol" text="TOTAL" prefWidth="120"/>
                                            <TableColumn fx:id="gradeCol" text="GRADE" prefWidth="120"/>
                                            <TableColumn fx:id="remarkCol" text="REMARK" prefWidth="200"/>
                                        </columns>
                                    </TableView>

                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- LOADING OVERLAY -->
                <VBox fx:id="loadingOverlay"
                      alignment="CENTER"
                      spacing="15"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(0,0,0,0.35);">

                    <ProgressIndicator fx:id="loadingSpinner" />

                    <Label text="Loading dashboard..."
                           style="-fx-text-fill: white; -fx-font-size: 14;" />
                </VBox>

            </StackPane>
        </center>
    </BorderPane>

</StackPane>