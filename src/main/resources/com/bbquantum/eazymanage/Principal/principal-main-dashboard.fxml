<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.PrincipalController"
            style="-fx-background-color: #f5f7fa;">

    <!-- LEFT SIDEBAR - Navigation -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #2c3e50; -fx-min-width: 250; -fx-pref-width: 250;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 30 20 30 20; -fx-background-color: #1a252f;">
                <Label text="🎓" style="-fx-font-size: 40px;"/>
                <Label text="EAZY MANAGE" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Principal Portal" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
            </VBox>

            <Separator style="-fx-background-color: #34495e;"/>

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 20 10 20 10;">

                <!-- Main Dashboard Button -->
                <Button fx:id="mainDashboardBtn" text="📊 Main Dashboard" onAction="#showMainDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand;">
                </Button>

                <!-- Staff Dashboard Button -->
                <Button fx:id="staffDashboardBtn" text="👥 Staff Dashboard" onAction="#showStaffDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>

                <!-- Finance Dashboard Button -->
                <Button fx:id="financeDashboardBtn" text="💰 Finance Dashboard" onAction="#showFinanceDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>

                <!-- Student Dashboard Button -->
                <Button fx:id="studentDashboardBtn" text="🎒 Student Dashboard" onAction="#showStudentDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>
            </VBox>

            <!-- Spacer to push logout to bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Info & Logout -->
            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #1a252f;">
                <Separator style="-fx-background-color: #34495e;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 24px;"/>
                    <VBox spacing="2">
                        <Label fx:id="institutionNameLabel" text="School Name" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="principalNameLabel" text="Principal Name" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand;">
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- RIGHT CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f5f7fa;">

            <!-- MAIN DASHBOARD VIEW (Default) -->
            <ScrollPane fx:id="mainDashboardView" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="25" style="-fx-padding: 30;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox spacing="5">
                            <Label text="Main Dashboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label fx:id="dateTimeLabel" text="Monday, November 25, 2025 | 2:30 PM" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </HBox>

                    <!-- Statistics Cards -->
                    <GridPane hgap="20" vgap="20">

                        <!-- Total Students Card -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              GridPane.columnIndex="0" GridPane.rowIndex="0" minWidth="200">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="🎓" style="-fx-font-size: 36px;"/>
                                <VBox spacing="5">
                                    <Label text="Total Students" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="totalStudentsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                            <Label text="Enrolled students" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Total Staff Card -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" minWidth="200">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="👥" style="-fx-font-size: 36px;"/>
                                <VBox spacing="5">
                                    <Label text="Total Staff" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="totalStaffLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                            <Label text="Active staff members" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Total Semester Fees Card -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              GridPane.columnIndex="0" GridPane.rowIndex="1" minWidth="200">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="💵" style="-fx-font-size: 36px;"/>
                                <VBox spacing="5">
                                    <Label text="Semester Fees" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="semesterFeesLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                            <Label text="Total expected fees" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Total Fees Paid Card -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              GridPane.columnIndex="1" GridPane.rowIndex="1" minWidth="200">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="✅" style="-fx-font-size: 36px;"/>
                                <VBox spacing="5">
                                    <Label text="Fees Paid" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="feesPaidLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </VBox>
                            </HBox>
                            <ProgressBar fx:id="feesProgressBar" progress="0.0" maxWidth="Infinity" style="-fx-accent: #27ae60;"/>
                        </VBox>
                    </GridPane>

                    <!-- Recently Added Students Section -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋 Recently Added Students" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="View All" onAction="#viewAllStudents"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator/>

                        <!-- Students Table -->
                        <TableView fx:id="recentStudentsTable" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn text="Student ID" prefWidth="120" fx:id="studentIdColumn"/>
                                <TableColumn text="Name" prefWidth="200" fx:id="studentNameColumn"/>
                                <TableColumn text="Level" prefWidth="100" fx:id="studentLevelColumn"/>
                                <TableColumn text="Date Added" prefWidth="150" fx:id="dateAddedColumn"/>
                            </columns>
                            <placeholder>
                                <Label text="No recent students" style="-fx-text-fill: #95a5a6;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>



            <!--
            PRINCIPAL FINANCE DASHBOARD
            -->
            <ScrollPane fx:id="financeDashboardView" visible="false" managed="false" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="25" style="-fx-padding: 30;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox spacing="5">
                            <Label text="Finance Dashboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label text="Monitor fees and payment records" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </HBox>

                    <!-- Financial Summary Cards -->
                    <HBox spacing="20">
                        <!-- Total Semester Fees Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="💵" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Total Semester Fees" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="totalSemesterFeesLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                            <Label text="Expected revenue for current semester" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Amount Paid Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="✅" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Amount Paid" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="amountPaidLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="collectionPercentageLabel" text="0%" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                    <Label text="collected" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                </HBox>
                                <ProgressBar fx:id="collectionProgressBar" progress="0.0" maxWidth="Infinity" style="-fx-accent: #27ae60;"/>
                            </VBox>
                        </VBox>

                        <!-- Outstanding Balance Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="⏳" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Outstanding" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="outstandingBalanceLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                </VBox>
                            </HBox>
                            <Label text="Pending payments" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>
                    </HBox>

                    <!-- Student Fee Report Search Section -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <Label text="🔍 Student Fee Report" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <Separator/>

                        <!-- Search Filters -->
                        <GridPane hgap="15" vgap="15">

                            <!-- Student ID Search -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Student ID" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <TextField fx:id="studentIdSearchField" promptText="Enter Student ID"
                                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                            </VBox>

                            <!-- Semester Selection -->
                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Semester" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="semesterComboBox" promptText="Select Semester" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>

                            <!-- Class/Level Selection -->
                            <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Class/Level" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="classLevelComboBox" promptText="Select Class" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>

                            <!-- Search Button -->
                            <VBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label text=" " style="-fx-font-size: 13px;"/> <!-- Spacer -->
                                <Button fx:id="searchFeesHistoryBtn" text="🔍 Search" onAction="#handleSearchStudentFees"
                                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                    <effect>
                                        <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                    </effect>
                                </Button>
                            </VBox>
                        </GridPane>

                        <!-- Quick Filter Buttons -->
                        <HBox spacing="10">
                            <Label text="Quick Filters:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-padding: 5 5 0 0;"/>
                            <Button text="Fully Paid" onAction="#showFullyPaid"
                                    style="-fx-background-color: #d4edda; -fx-text-fill: #155724; -fx-font-size: 11px; -fx-padding: 5 12 5 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            <Button text="Partial Payment" onAction="#showPartialPayment"
                                    style="-fx-background-color: #fff3cd; -fx-text-fill: #856404; -fx-font-size: 11px; -fx-padding: 5 12 5 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            <Button text="Not Paid" onAction="#showNotPaid"
                                    style="-fx-background-color: #f8d7da; -fx-text-fill: #721c24; -fx-font-size: 11px; -fx-padding: 5 12 5 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Filtered Students Table (Hidden by default) -->
                        <VBox fx:id="filteredStudentsPanel" spacing="15" visible="false" managed="false"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #667eea; -fx-border-width: 2; -fx-border-radius: 10;">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="filterTitleLabel" text="Filtered Students" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="filteredCountLabel" text="0 students found" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                            </HBox>

                            <Separator/>

                            <!-- Filtered Students Table -->
                            <TableView fx:id="filteredStudentsTable" style="-fx-background-color: transparent;" maxHeight="400">
                                <columns>
                                    <TableColumn text="Student ID" prefWidth="120" fx:id="filteredStudentIdColumn"/>
                                    <TableColumn text="Student Name" prefWidth="180" fx:id="filteredStudentNameColumn"/>
                                    <TableColumn text="Class" prefWidth="100" fx:id="filteredStudentClassColumn"/>
                                    <TableColumn text="Total Fees" prefWidth="110" fx:id="filteredTotalFeesColumn"/>
                                    <TableColumn text="Amount Paid" prefWidth="120" fx:id="filteredAmountPaidColumn"/>
                                    <TableColumn text="Balance" prefWidth="110" fx:id="filteredBalanceColumn"/>
                                </columns>
                                <placeholder>
                                    <Label text="No students match this filter" style="-fx-text-fill: #95a5a6;"/>
                                </placeholder>
                            </TableView>

                            <HBox spacing="15" alignment="CENTER_RIGHT">
                                <Button text="Clear Filter" onAction="#handleClearFilter"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                                <Button text="📥 Export Filtered List" onAction="#handleExportFilteredList"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- Student Fee Report Result (Hidden by default) -->
                        <VBox fx:id="feeReportPanel" spacing="20" visible="false" managed="false"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 25; -fx-border-color: #667eea; -fx-border-width: 2; -fx-border-radius: 10;">

                            <!-- Student Info Header -->
                            <HBox alignment="CENTER_LEFT" spacing="20">
                                <Label text="🎓" style="-fx-font-size: 36px;"/>
                                <VBox spacing="5">
                                    <Label fx:id="studentNameLabel" text="Student Name" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <HBox spacing="15">
                                        <Label fx:id="studentIdDisplayLabel" text=" " style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                        <Label text="•" style="-fx-text-fill: #7f8c8d;"/>
                                        <Label fx:id="studentClassLabel" text="Class: Form 1A" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                        <Label text="•" style="-fx-text-fill: #7f8c8d;"/>
                                        <Label fx:id="studentSemesterLabel" text="Semester: 1st" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <Separator/>

                            <!-- Fee Breakdown -->
                            <GridPane hgap="20" vgap="15">

                                <!-- Total Fees -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Total Fees" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="studentTotalFeesLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>

                                <!-- Amount Paid -->
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Amount Paid" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="studentAmountPaidLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </VBox>

                                <!-- Balance -->
                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Balance" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="studentBalanceLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                </VBox>
                            </GridPane>

                            <!-- Progress Bar -->
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Payment Progress:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="studentPaymentPercentageLabel" text="0%" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </HBox>
                                <ProgressBar fx:id="studentPaymentProgressBar" progress="0.0" maxWidth="Infinity" style="-fx-accent: #27ae60; -fx-pref-height: 15;"/>
                            </VBox>

                            <!-- Payment History Table -->
                            <VBox spacing="10">
                                <Label text="Payment History" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <TableView fx:id="paymentHistoryTable" style="-fx-background-color: transparent;" maxHeight="200">
                                    <columns>
                                        <TableColumn text="Date" prefWidth="120" fx:id="paymentDateColumn"/>
                                        <TableColumn text="Amount Paid" prefWidth="120" fx:id="paymentAmountColumn"/>
                                        <TableColumn text="Payment Person" prefWidth="130" fx:id="paymentPersonColumn"/>
                                        <TableColumn text="Contact Info" prefWidth="120" fx:id="paymentPersonContactColumn"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No payment records" style="-fx-text-fill: #95a5a6;"/>
                                    </placeholder>
                                </TableView>
                            </VBox>

                            <!-- Actions -->
                            <HBox spacing="15" alignment="CENTER_RIGHT">
                                <Button text="📄 Print Report" onAction="#handlePrintReport"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- No Student Found Message (Hidden by default) -->
                        <VBox fx:id="noStudentFoundPanel" spacing="10" alignment="CENTER" visible="false" managed="false"
