<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Master Score Sheet viewer (Phase 5c).

    Filters: class + semester. The subject columns are dynamic — added at
    runtime in the controller from the loaded sheet, since the column set
    varies by class. Fixed columns at left (id, name) and right (total,
    average, position) are added programmatically too so the table is
    consistent regardless of how many subjects are present.

    Horizontal scrolling is expected: a JHS class with 13 subjects gives
    ~18 columns. The ScrollPane around the TableView keeps the action bar
    in view when scrolling horizontally.
-->
<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Report.MasterSheetReportController"
      styleClass="report-viewer"
      spacing="0">

    <stylesheets>
        <URL value="@../../Theme/reports.css"/>
    </stylesheets>

    <!-- Header / breadcrumb -->
    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Button fx:id="backButton" text="◂  Reporting Center"
                    onAction="#onBack" styleClass="btn,btn-ghost,breadcrumb-back"/>
        </HBox>
        <Label text="Master Score Sheet" styleClass="page-title"/>
        <Label fx:id="subtitleLabel"
               text="One row per student, one column per subject. Scroll horizontally for wide classes."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <!-- Filters -->
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

        <Label text="Class" styleClass="field-label"/>
        <ChoiceBox fx:id="classChoice" prefWidth="200"/>

        <Label text="Semester" styleClass="field-label"/>
        <ChoiceBox fx:id="semesterChoice" prefWidth="200"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="loadButton" text="Load sheet" onAction="#onLoad" styleClass="btn,btn-primary"/>
    </HBox>

    <Separator/>

    <!-- Sheet -->
    <ScrollPane VBox.vgrow="ALWAYS"
                fitToWidth="false" fitToHeight="true"
                hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                styleClass="transparent-scroll master-sheet-scroll">
        <TableView fx:id="sheetTable" styleClass="master-sheet-table">
            <placeholder>
                <Label text="Pick a class and semester, then click 'Load sheet'."
                       styleClass="empty-state"/>
            </placeholder>
        </TableView>
    </ScrollPane>

    <!-- Action bar -->
    <VBox styleClass="action-bar">
        <Separator/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

            <Label fx:id="sheetMetaLabel" styleClass="save-status"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" styleClass="save-status"/>
            <Button fx:id="downloadButton" text="Download PDF"
                    onAction="#onDownload" styleClass="btn,btn-primary"
                    disable="true"/>
        </HBox>
    </VBox>
</VBox>
