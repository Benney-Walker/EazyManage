<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Report.ClassResultsReportController"
      styleClass="report-viewer"
      spacing="0">

    <stylesheets>
        <URL value="@../../Theme/reports.css"/>
    </stylesheets>

    <!-- Header / breadcrumb -->
    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Button fx:id="backButton" text="◂  Reporting Center"
                    onAction="#onBack" styleClass="btn,btn-ghost,breadcrumb-back"/>
        </HBox>
        <Label text="Class Results" styleClass="page-title"/>
        <Label text="Term performance summary for one class, one semester. Open a row to see per-subject scores."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <!-- Filters -->
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

        <Label text="Class" styleClass="field-label"/>
        <ChoiceBox fx:id="classChoice" prefWidth="200"/>

        <Label text="Semester" styleClass="field-label"/>
        <ChoiceBox fx:id="semesterChoice" prefWidth="200"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="loadButton" text="Load report" onAction="#onLoad" styleClass="btn,btn-primary"/>
    </HBox>

    <Separator/>

    <!-- Class results table (master) -->
    <VBox VBox.vgrow="ALWAYS" spacing="0">
        <Label text="Students" styleClass="panel-heading">
            <padding><Insets top="12" right="24" bottom="6" left="24"/></padding>
        </Label>

        <TableView fx:id="classResultsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="studentIdCol"    text="Student ID" prefWidth="110"/>
                <TableColumn fx:id="studentNameCol"  text="Name"       prefWidth="220"/>
                <TableColumn fx:id="totalCol"        text="Total"      prefWidth="80"/>
                <TableColumn fx:id="averageCol"      text="Average"    prefWidth="80"/>
                <TableColumn fx:id="positionCol"     text="Position"   prefWidth="80"/>
            </columns>
            <placeholder>
                <Label text="Pick a class and semester, then click 'Load report'."
                       styleClass="empty-state"/>
            </placeholder>
        </TableView>

        <!-- Subject breakdown (detail) -->
        <VBox fx:id="subjectBreakdownBox"
              visible="false" managed="false"
              styleClass="subject-breakdown" spacing="6">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

            <Label fx:id="breakdownHeadingLabel" text="" styleClass="panel-heading"/>

            <TableView fx:id="subjectBreakdownTable" prefHeight="240">
                <columns>
                    <TableColumn fx:id="subjectNameCol"     text="Subject"        prefWidth="170"/>
                    <TableColumn fx:id="classTest1ColView"  text="CT 1"           prefWidth="60"/>
                    <TableColumn fx:id="groupWorkColView"   text="Group Work"     prefWidth="100"/>
                    <TableColumn fx:id="classTest2ColView"  text="CT 2"           prefWidth="60"/>
                    <TableColumn fx:id="projectColView"     text="Project"        prefWidth="80"/>
                    <TableColumn fx:id="classScoreColView"  text="Class (50%)"    prefWidth="100"/>
                    <TableColumn fx:id="examScoreColView"   text="Exam"           prefWidth="70"/>
                    <TableColumn fx:id="calcExamColView"    text="Exam (50%)"     prefWidth="90"/>
                    <TableColumn fx:id="subjectTotalCol"    text="Total"          prefWidth="70"/>
                    <TableColumn fx:id="gradeCol"           text="Grade"          prefWidth="60"/>
                    <TableColumn fx:id="descriptionCol"     text="Remark"         prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

    <!-- Action bar -->
    <VBox styleClass="action-bar">
        <Separator/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

            <!--
            <Label fx:id="promotionLabel" text="Promotion (optional)" styleClass="field-label" visible="false" managed="false"/>
            <ChoiceBox fx:id="promotionGradeChoice" prefWidth="180" visible="false" managed="false"/>
            <Label fx:id="passScoreLabel" text="Pass score" styleClass="field-label" visible="false" managed="false"/>
            <TextField fx:id="passScoreField" prefWidth="80" promptText="e.g. 50" visible="false" managed="false"/>
            -->

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" styleClass="save-status"/>
            <Button fx:id="downloadButton" text="Download PDF"
                    onAction="#onDownload" styleClass="btn,btn-primary"
                    disable="true"/>
        </HBox>
    </VBox>
</VBox>
