<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>


<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Report.ReportCardReportController"
      styleClass="report-viewer"
      spacing="0">

    <stylesheets>
        <URL value="@../../Theme/reports.css"/>
    </stylesheets>

    <!-- Header / breadcrumb -->
    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Button fx:id="backButton" text="◂  Reporting Center"
                    onAction="#onBack" styleClass="btn,btn-ghost,breadcrumb-back"/>
        </HBox>
        <Label text="Student Report Card" styleClass="page-title"/>
        <Label text="Pick a class, then a student. The report combines academic results, conduct, and teacher remarks."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <!-- Toolbar -->
    <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

        <Label text="Class" styleClass="field-label"/>
        <ChoiceBox fx:id="classChoice" prefWidth="200"/>

        <Label text="Semester" styleClass="field-label"/>
        <ChoiceBox fx:id="semesterChoice" prefWidth="200"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="save-status"/>
        <Button fx:id="refreshStudentsBtn" text="Reload students"
                onAction="#onReloadStudents" styleClass="btn,btn-secondary"/>
    </HBox>

    <Separator/>

    <!-- Two-pane: students on the left, paper preview on the right -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- Left: student picker -->
        <VBox prefWidth="320" minWidth="280" maxWidth="380" styleClass="conduct-list-panel">
            <Label text="Students in class" styleClass="panel-heading">
                <padding><Insets top="12" right="16" bottom="6" left="16"/></padding>
            </Label>

            <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="studentIdCol"   text="Student ID" prefWidth="110"/>
                    <TableColumn fx:id="studentNameCol" text="Name"       prefWidth="200"/>
                </columns>
                <placeholder>
                    <Label text="Pick a class to list students." styleClass="empty-state"/>
                </placeholder>
            </TableView>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <!-- Right: paper preview -->
        <VBox HBox.hgrow="ALWAYS" styleClass="report-card-pane">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                <VBox fx:id="cardPaper" styleClass="report-card-paper" spacing="14">
                    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

                    <!-- School header -->
                    <VBox styleClass="report-card-school-header" alignment="CENTER" spacing="2">
                        <Label fx:id="schoolNameLabel" text="School Name" styleClass="report-card-school-name"/>
                        <Label text="TERMINAL REPORT" styleClass="report-card-doc-title"/>
                    </VBox>

                    <Separator/>

                    <!-- Student / term metadata, 3 rows x 6 columns
                         (label/value pairs across three rows) -->
                    <GridPane hgap="12" vgap="6" styleClass="report-card-meta">
                        <!-- Row 0: NAME · POSITION · STUDENT ID -->
                        <Label text="NAME:"       GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="meta-label"/>
                        <Label fx:id="nameValue"      GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="meta-value"/>
                        <Label text="POSITION:"   GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="meta-label"/>
                        <Label fx:id="positionValue"  GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="meta-value"/>
                        <Label text="STUDENT ID:" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="meta-label"/>
                        <Label fx:id="studentIdValue" GridPane.columnIndex="5" GridPane.rowIndex="0" styleClass="meta-value"/>

                        <!-- Row 1: GRADE · CLASS SIZE · TERM -->
                        <Label text="GRADE:"      GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="meta-label"/>
                        <Label fx:id="gradeValue"     GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="meta-value"/>
                        <Label text="CLASS SIZE:" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="meta-label"/>
                        <Label fx:id="classSizeValue" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="meta-value"/>
                        <Label text="TERM:"       GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="meta-label"/>
                        <Label fx:id="termValue"      GridPane.columnIndex="5" GridPane.rowIndex="1" styleClass="meta-value"/>

                        <!-- Row 2: YEAR · VACATION · RESUMPTION -->
                        <Label text="YEAR:"       GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="meta-label"/>
                        <Label fx:id="yearValue"      GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="meta-value"/>
                        <Label text="VACATION:"   GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="meta-label"/>
                        <Label fx:id="vacationValue"  GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="meta-value"/>
                        <Label text="RESUMPTION:" GridPane.columnIndex="4" GridPane.rowIndex="2" styleClass="meta-label"/>
                        <Label fx:id="resumptionValue" GridPane.columnIndex="5" GridPane.rowIndex="2" styleClass="meta-value"/>
                    </GridPane>

                    <!-- Subject results table -->
                    <TableView fx:id="subjectsTable" prefHeight="320" styleClass="report-card-table">
                        <columns>
                            <TableColumn fx:id="subjectCol"     text="SUBJECT"      prefWidth="180"/>
                            <TableColumn fx:id="classScoreCol"  text="CLASS SCORE"  prefWidth="100"/>
                            <TableColumn fx:id="examScoreCol"   text="EXAM SCORE"   prefWidth="100"/>
                            <TableColumn fx:id="totalScoreCol"  text="TOTAL SCORE"  prefWidth="100"/>
                            <TableColumn fx:id="gradeCol"       text="GRADE"        prefWidth="70"/>
                            <TableColumn fx:id="remarksCol"     text="REMARKS"      prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <Label text="No academic results recorded for this semester." styleClass="empty-state"/>
                        </placeholder>
                    </TableView>

                    <!-- Grading system caption -->
                    <VBox spacing="2">
                        <Label text="GRADING SYSTEM:" styleClass="report-card-section-title"/>
                        <Label text="80–100 (Highly Proficiency) | 70–79 (Proficiency) | 60–69 (Approaching Proficiency) | 50–59 (Developing) | 49–0"
                               styleClass="report-card-grading-caption" wrapText="true"/>
                    </VBox>

                    <!-- Conduct grid — built at runtime in the controller -->
                    <GridPane fx:id="conductGrid" styleClass="report-card-conduct-grid"/>

                    <!-- Attendance / Promoted To -->
                    <HBox spacing="32" styleClass="report-card-attendance-row" alignment="CENTER_LEFT">
                        <Label text="ATTENDANCE:" styleClass="meta-label"/>
                        <Label fx:id="attendancePresentValue" styleClass="meta-value"/>
                        <Label text="OUT OF:" styleClass="meta-label"/>
                        <Label fx:id="totalAttendanceValue"   styleClass="meta-value"/>
                        <Label text="PROMOTED TO:" styleClass="meta-label"/>
                        <Label fx:id="promotedToValue"        styleClass="meta-value"/>
                    </HBox>

                    <!-- Peculiar issue — paper fill only, no backend field -->
                    <VBox spacing="8" >
                        <Label text="PECULIAR ISSUE:" styleClass="meta-label"/>
                        <Label fx:id="peculiarIssueLabel"
                               styleClass="report-card-remark-block"
                               wrapText="true"/>
                    </VBox>

                    <!-- Facilitator's remarks -->
                    <VBox spacing="4">
                        <Label text="FACILITATOR'S REMARKS:" styleClass="meta-label"/>
                        <Label fx:id="facilitatorRemarkLabel"
                               styleClass="report-card-remark-block"
                               wrapText="true"/>
                    </VBox>

                    <!-- Signature lines -->
                    <HBox spacing="24" alignment="CENTER_LEFT" styleClass="report-card-signature-row">
                        <Label text="FACILITATOR'S SIGN:" styleClass="meta-label"/>
                        <Region HBox.hgrow="ALWAYS" styleClass="report-card-fill-line"/>
                        <Label text="NAME:" styleClass="meta-label"/>
                        <Label fx:id="instructorNameValue" styleClass="meta-value"/>
                    </HBox>

                    <HBox spacing="24" alignment="CENTER_LEFT" styleClass="report-card-signature-row">
                        <Label text="HEAD FACILITATOR'S SIGN:" styleClass="meta-label"/>
                        <Region HBox.hgrow="ALWAYS" styleClass="report-card-fill-line"/>
                        <Label text="DATE:" styleClass="meta-label"/>
                        <Label fx:id="currentDateValue" styleClass="meta-value"/>
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- Action bar -->
            <VBox styleClass="action-bar">
                <Separator/>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

                    <Label fx:id="promotionLabel" text="Promotion (optional)" styleClass="field-label" visible="false" managed="false"/>
                    <ChoiceBox fx:id="promotionClassChoice" prefWidth="180" visible="false" managed="false"/>
                    <Button fx:id="promoteButton" text="Promote Student"
                            onAction="#onPromote" styleClass="btn,btn-primary"
                            disable="true"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="repeatButton" text="Repeat Student"
                            onAction="#onRepeat" styleClass="btn,btn-primary"
                            disable="true"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="downloadButton" text="Download PDF"
                            onAction="#onDownload" styleClass="btn,btn-primary"
                            disable="true"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
