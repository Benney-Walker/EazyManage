<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bbquantum.eazymanage.Controller.Staff.PasswordResetDialogController"
           styleClass="dialog-backdrop"
           prefWidth="520" prefHeight="380">

    <VBox styleClass="dialog" spacing="14" maxWidth="420" maxHeight="-Infinity">

        <Label text="Reset password" styleClass="dialog-title"/>
        <Label fx:id="subtitleLabel" wrapText="true" styleClass="dialog-body"/>

        <!-- New password -->
        <VBox spacing="6">
            <Label text="New password" styleClass="field-label"/>
            <StackPane>
                <PasswordField fx:id="newPasswordField"
                               promptText="Enter new password"
                               styleClass="input,password-field"
                               maxWidth="Infinity"/>
                <TextField     fx:id="newPasswordPlainField"
                               promptText="Enter new password"
                               styleClass="input"
                               visible="false" managed="false"
                               maxWidth="Infinity"/>
            </StackPane>
        </VBox>

        <!-- Confirm password -->
        <VBox spacing="6">
            <Label text="Confirm password" styleClass="field-label"/>
            <StackPane>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Re-enter new password"
                               styleClass="input,password-field"
                               maxWidth="Infinity"/>
                <TextField     fx:id="confirmPasswordPlainField"
                               promptText="Re-enter new password"
                               styleClass="input"
                               visible="false" managed="false"
                               maxWidth="Infinity"/>
            </StackPane>
        </VBox>

        <CheckBox fx:id="showPasswordsCheck"
                  text="Show passwords"
                  onAction="#onToggleVisibility"/>

        <Label fx:id="statusLabel" styleClass="save-status" wrapText="true"/>

        <HBox styleClass="dialog-actions">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="cancelButton" text="Cancel"
                    onAction="#onCancel" styleClass="btn,btn-ghost"/>
            <Button fx:id="resetButton"  text="Reset password"
                    onAction="#onReset"  styleClass="btn,btn-primary"
                    defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
