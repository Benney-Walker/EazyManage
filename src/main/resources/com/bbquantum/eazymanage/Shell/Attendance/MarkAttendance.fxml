<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Mark Attendance flow (Phase 9a).

    Layout (top to bottom):
      1. Class picker row — ChoiceBox + "Fetch students" button.
      2. Optional class info banner (visible after a successful fetch).
      3. Attendance table — student rows with toggle controls per row.
      4. Action bar at the bottom — Save / Cancel + progress bar during save.

    Status semantics: each row's status is one of PRESENT / ABSENT. The
    table renders the status via a custom radio cell (Phase 1 control).
    Default status when newly fetched: PRESENT for every student. The
    teacher toggles whoever's absent.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Attendance.MarkAttendanceController"
      styleClass="mark-attendance"
      spacing="0">

    <!-- Class picker -->
    <HBox styleClass="page-toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="14" right="24" bottom="10" left="24"/></padding>

        <Label text="Class" styleClass="field-label"/>
        <ChoiceBox fx:id="classChoice" prefWidth="220"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="fetchButton" text="Fetch students"
                onAction="#onFetch" styleClass="btn,btn-primary"/>
    </HBox>

    <Separator/>

    <!-- Class info banner -->
    <HBox fx:id="classInfoBanner" visible="false" managed="false"
          styleClass="info-banner" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
        <Label text="📚" styleClass="info-icon"/>
        <VBox spacing="2">
            <Label fx:id="classNameLabel" styleClass="info-title"/>
            <Label fx:id="classMetaLabel" styleClass="info-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="rowCountLabel" styleClass="info-subtitle"/>
    </HBox>

    <!-- Attendance table -->
    <TableView fx:id="attendanceTable" editable="true"
               VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="studentIdCol"  text="Student ID"   prefWidth="140"/>
            <TableColumn fx:id="nameCol"       text="Student Name" prefWidth="320"/>
            <TableColumn fx:id="absentCol"     text="Absent"       prefWidth="100"/>
            <TableColumn fx:id="presentCol"    text="Present"      prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Pick a class and click 'Fetch students' to begin."
                   styleClass="empty-state"/>
        </placeholder>
    </TableView>

    <!-- Action bar -->
    <VBox styleClass="action-bar">
        <Separator/>

        <!-- Progress bar (visible during save) -->
        <VBox fx:id="progressBox" visible="false" managed="false" spacing="4">
            <padding><Insets top="8" right="24" bottom="0" left="24"/></padding>
            <Label fx:id="progressLabel" text="Saving…" styleClass="save-status"/>
            <ProgressBar fx:id="progressBar" prefHeight="6" maxWidth="Infinity" progress="0"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Label fx:id="statusLabel" styleClass="save-status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="cancelButton" text="Reset" onAction="#onReset"
                    styleClass="btn,btn-ghost"/>
            <Button fx:id="saveButton"   text="Save attendance" onAction="#onSave"
                    styleClass="btn,btn-primary" disable="true"/>
        </HBox>
    </VBox>
</VBox>
