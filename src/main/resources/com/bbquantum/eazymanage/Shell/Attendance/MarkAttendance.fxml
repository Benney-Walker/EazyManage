<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.DatePicker?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Attendance.MarkAttendanceController"
      styleClass="mark-attendance"
      spacing="0">

    <!-- Toolbar -->
    <HBox styleClass="page-toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="14" right="24" bottom="10" left="24"/></padding>

        <Label text="Class" styleClass="field-label"/>
        <ChoiceBox fx:id="classChoice" prefWidth="220"/>

        <Label text="Date" styleClass="field-label"/>
        <DatePicker fx:id="datePicker" prefWidth="160"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="fetchButton" text="Fetch students"
                onAction="#onFetch" styleClass="btn,btn-primary"/>
    </HBox>

    <Separator/>

    <!-- Class info banner -->
    <HBox fx:id="classInfoBanner" visible="false" managed="false"
          styleClass="info-banner" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="24" bottom="10" left="24"/></padding>
        <Label text="📚" styleClass="info-icon"/>
        <VBox spacing="2">
            <Label fx:id="classNameLabel" styleClass="info-title"/>
            <Label fx:id="classMetaLabel" styleClass="info-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="rowCountLabel" styleClass="info-subtitle"/>
    </HBox>

    <!-- Attendance table -->
    <TableView fx:id="attendanceTable" editable="true"
               VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="studentIdCol"  text="Student ID"   prefWidth="140"/>
            <TableColumn fx:id="nameCol"       text="Student Name" prefWidth="320"/>
            <TableColumn fx:id="absentCol"     text="Absent"       prefWidth="100"/>
            <TableColumn fx:id="presentCol"    text="Present"      prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Pick a class and click 'Fetch students' to begin."
                   styleClass="empty-state"/>
        </placeholder>
    </TableView>

    <!-- Action bar -->
    <VBox styleClass="action-bar">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button fx:id="markPresentButton"   text="Mark All Present" onAction="#onMarkAllPresent"
                    styleClass="btn,btn-primary" disable="true"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" styleClass="save-status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="cancelButton" text="Reset" onAction="#onReset"
                    styleClass="btn,btn-ghost" disable="true"/>
            <Button fx:id="saveButton"   text="Save attendance" onAction="#onSave"
                    styleClass="btn,btn-primary" disable="true"/>
        </HBox>
    </VBox>
</VBox>
