<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Active Sessions view (Phase 6).

    Bound to PresenceTracker — server is the source of truth, the client
    only renders. Refresh happens automatically whenever the server fans
    out a new snapshot on /topic/active-sessions.
-->
<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.WebSocket.ActiveSessionsController"
      styleClass="active-sessions-screen"
      spacing="0">

    <stylesheets>
        <URL value="@../Theme/broadcasts.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Active Sessions" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="page-subtitle"/>
        </HBox>
        <Label text="Staff connected to the realtime channel right now. Updates automatically."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <Separator/>

    <TableView fx:id="sessionsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="staffIdCol"      text="Staff ID"    prefWidth="120"/>
            <TableColumn fx:id="displayNameCol"  text="Name"        prefWidth="220"/>
            <TableColumn fx:id="roleCol"         text="Role"        prefWidth="150"/>
            <TableColumn fx:id="connectedAtCol"  text="Connected"   prefWidth="180"/>
            <TableColumn fx:id="lastSeenAtCol"   text="Last seen"   prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No active sessions yet. Sessions appear here as staff sign in." styleClass="empty-state"/>
        </placeholder>
    </TableView>
</VBox>
