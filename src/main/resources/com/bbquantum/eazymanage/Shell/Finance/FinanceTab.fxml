<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.Finance.FinanceTabController"
      styleClass="finance-tab"
      spacing="0">

    <stylesheets>
        <URL value="@../../Theme/finance.css"/>
    </stylesheets>

    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <Label text="Finance" styleClass="page-title"/>
        <Label text="Set up fees, record payments, and review payment records."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <Separator/>

    <StackPane fx:id="contentSlot" VBox.vgrow="ALWAYS">

        <!-- State A: picker -->
        <VBox fx:id="pickerView" alignment="CENTER" spacing="24">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

            <Label text="What would you like to do?" styleClass="picker-prompt"/>

            <HBox spacing="20" alignment="CENTER" styleClass="picker-card-row">
                <VBox styleClass="picker-card" alignment="CENTER" spacing="12"
                      prefWidth="230" minHeight="200" onMouseClicked="#onPickFees">
                    <Label text="💰" styleClass="picker-card-icon"/>
                    <Label text="Fees Setup" styleClass="picker-card-title"/>
                    <Label text="Add or update fees per class and semester."
                           styleClass="picker-card-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>
                <VBox styleClass="picker-card" alignment="CENTER" spacing="12"
                      prefWidth="230" minHeight="200" onMouseClicked="#onPickPayments">
                    <Label text="🧾" styleClass="picker-card-icon"/>
                    <Label text="Record Payments" styleClass="picker-card-title"/>
                    <Label text="Log a new payment or amend an existing one."
                           styleClass="picker-card-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>
                <VBox styleClass="picker-card" alignment="CENTER" spacing="12"
                      prefWidth="230" minHeight="200" onMouseClicked="#onPickClassReport">
                    <Label text="📊" styleClass="picker-card-icon"/>
                    <Label text="Class Payments" styleClass="picker-card-title"/>
                    <Label text="Browse all payments for a class+semester."
                           styleClass="picker-card-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>
                <VBox styleClass="picker-card" alignment="CENTER" spacing="12"
                      prefWidth="230" minHeight="200" onMouseClicked="#onPickStudentReport">
                    <Label text="🧑‍🎓" styleClass="picker-card-icon"/>
                    <Label text="Student Payments" styleClass="picker-card-title"/>
                    <Label text="Look up one student's payment history."
                           styleClass="picker-card-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- State B: inner tabs -->
        <TabPane fx:id="innerTabs" visible="false" managed="false"
                 tabClosingPolicy="UNAVAILABLE" styleClass="inner-tabs">
            <tabs>
                <Tab fx:id="feesTab"           text="Fees Setup"/>
                <Tab fx:id="paymentsTab"       text="Record Payments"/>
                <Tab fx:id="classReportTab"    text="Class Payments"/>
                <Tab fx:id="studentReportTab"  text="Student Payments"/>
            </tabs>
        </TabPane>

    </StackPane>
</VBox>
