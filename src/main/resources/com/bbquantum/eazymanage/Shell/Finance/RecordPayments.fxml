<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.Finance.RecordPaymentsController"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="record-payments,transparent-scroll">

    <VBox spacing="20">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

        <!-- ===== New payment form ===== -->
        <VBox spacing="14" styleClass="form-card">
            <Label text="New Payment" styleClass="form-section-title"/>

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints minWidth="200" prefWidth="240" hgrow="SOMETIMES"/>
                    <javafx.scene.layout.ColumnConstraints minWidth="200" prefWidth="240" hgrow="SOMETIMES"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Class" styleClass="field-label"/>
                    <ChoiceBox fx:id="newClassChoice" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Student" styleClass="field-label"/>
                    <ChoiceBox fx:id="newStudentChoice" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Semester" styleClass="field-label"/>
                    <ChoiceBox fx:id="semesterChoice" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Amount paid (GHS)" styleClass="field-label"/>
                    <TextField fx:id="amountField" promptText="e.g. 250"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Payer name" styleClass="field-label"/>
                    <TextField fx:id="payerNameField" promptText="Person who paid"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Payer phone" styleClass="field-label"/>
                    <TextField fx:id="payerPhoneField" promptText="e.g. 024 123 4567"/>
                </VBox>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="recordStatusLabel" styleClass="save-status"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="resetButton" text="Reset" onAction="#onReset" styleClass="btn,btn-ghost"/>
                <Button fx:id="recordButton" text="Record payment" onAction="#onRecord"
                        styleClass="btn,btn-primary"/>
            </HBox>
        </VBox>

        <!-- ===== Amend / delete card ===== -->
        <VBox spacing="14" styleClass="form-card">
            <Label text="Amend or Delete a Payment" styleClass="form-section-title"/>
            <Label text="Load a student's recorded payments for a class and semester, then click a row to edit or delete."
                   styleClass="form-hint" wrapText="true"/>

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints minWidth="160" prefWidth="200" hgrow="SOMETIMES"/>
                    <javafx.scene.layout.ColumnConstraints minWidth="160" prefWidth="200" hgrow="SOMETIMES"/>
                    <javafx.scene.layout.ColumnConstraints minWidth="160" prefWidth="200" hgrow="SOMETIMES"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Class" styleClass="field-label"/>
                    <ChoiceBox fx:id="loadClassChoice" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Student" styleClass="field-label"/>
                    <ChoiceBox fx:id="loadStudentChoice" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Semester" styleClass="field-label"/>
                    <ChoiceBox fx:id="loadSemesterChoice" maxWidth="Infinity"/>
                </VBox>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="loadStatusLabel" styleClass="save-status"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="loadButton" text="Load payments" onAction="#onLoad" styleClass="btn,btn-primary"/>
            </HBox>

            <TableView fx:id="paymentsTable" styleClass="modern-table" prefHeight="220">
                <columns>
                    <TableColumn fx:id="dateCol"        text="Date"     prefWidth="120"/>
                    <TableColumn fx:id="amountCol"      text="Amount"   prefWidth="100"/>
                    <TableColumn fx:id="payerNameCol"   text="Payer"    prefWidth="200"/>
                    <TableColumn fx:id="payerPhoneCol"  text="Phone"    prefWidth="160"/>
                </columns>
                <placeholder>
                    <Label text="Load payments to see the list." styleClass="empty-state"/>
                </placeholder>
            </TableView>

            <VBox fx:id="editBlock" spacing="14" visible="false" managed="false">
                <Separator/>
                <Label fx:id="editHeaderLabel" styleClass="form-section-title"/>

                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <javafx.scene.layout.ColumnConstraints minWidth="200" prefWidth="240" hgrow="SOMETIMES"/>
                        <javafx.scene.layout.ColumnConstraints minWidth="200" prefWidth="240" hgrow="SOMETIMES"/>
                    </columnConstraints>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Amount" styleClass="field-label"/>
                        <TextField fx:id="editAmountField"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Payer name" styleClass="field-label"/>
                        <TextField fx:id="editPayerNameField"/>
                    </VBox>
                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Payer phone" styleClass="field-label"/>
                        <TextField fx:id="editPayerPhoneField"/>
                    </VBox>
                </GridPane>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="editStatusLabel" styleClass="save-status"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="deleteButton" text="Delete payment" onAction="#onDelete"
                            styleClass="btn,btn-ghost,btn-danger"/>
                    <Button fx:id="saveButton" text="Save changes" onAction="#onSave"
                            styleClass="btn,btn-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
