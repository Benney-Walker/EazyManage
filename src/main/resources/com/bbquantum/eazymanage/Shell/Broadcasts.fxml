<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Broadcasts composer (Phase 6).

    A simple form: priority dropdown, audience checkboxes (or "All"),
    title, body, send button. Inbound broadcasts arriving while this
    screen is open are NOT mirrored here — they flow into the bell
    notification center just like every other notification.
-->
<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bbquantum.eazymanage.Controller.WebSocket.BroadcastsController"
      styleClass="broadcasts-screen"
      spacing="0">

    <stylesheets>
        <URL value="@../Theme/broadcasts.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox styleClass="page-header" spacing="4">
        <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
        <Label text="Broadcasts" styleClass="page-title"/>
        <Label text="Send a message to other staff in real time."
               styleClass="page-subtitle" wrapText="true"/>
    </VBox>

    <Separator/>

    <!-- Form -->
    <VBox spacing="14" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>

        <!-- Priority + Audience -->
        <HBox spacing="24" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Priority" styleClass="field-label"/>
                <ChoiceBox fx:id="priorityChoice" prefWidth="160"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Audience" styleClass="field-label"/>
                <HBox fx:id="audienceRow" spacing="12" alignment="CENTER_LEFT"/>
            </VBox>
        </HBox>

        <!-- Title -->
        <VBox spacing="4">
            <Label text="Title" styleClass="field-label"/>
            <TextField fx:id="titleField"
                       promptText="Short headline (shown in the notification bell)"
                       styleClass="broadcast-input"/>
        </VBox>

        <!-- Body -->
        <VBox spacing="4" VBox.vgrow="ALWAYS">
            <Label text="Message" styleClass="field-label"/>
            <TextArea fx:id="bodyField"
                      promptText="The body of your broadcast. Newlines are preserved."
                      wrapText="true"
                      VBox.vgrow="ALWAYS"
                      styleClass="broadcast-input"/>
        </VBox>
    </VBox>

    <!-- Action bar -->
    <VBox styleClass="action-bar">
        <Separator/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

            <Label fx:id="connectionStatusLabel" styleClass="save-status"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusLabel" styleClass="save-status"/>
            <Button fx:id="clearButton" text="Clear" onAction="#onClear" styleClass="btn,btn-ghost"/>
            <Button fx:id="sendButton"  text="Send broadcast"
                    onAction="#onSend" styleClass="btn,btn-primary"/>
        </HBox>
    </VBox>
</VBox>
