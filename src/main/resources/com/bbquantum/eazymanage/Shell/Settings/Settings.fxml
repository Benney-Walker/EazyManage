<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Settings tab (Phase 9-roles).

    Initial scope: role-switcher + read-only account info.

    Role-switcher behaviour:
      - Lists every role the JWT granted this user.
      - Marks the currently-active role with a chip.
      - "Switch role" button picks the chosen role, persists it, and
        full-scene-reloads the shell as if the user had logged in fresh
        with that role.
      - If the user only has one role, the switcher is shown disabled with
        explanatory text so they understand why they can't switch.

    Future settings (out of scope this phase): notification preferences,
    application-wide theme override, language, font scale, etc.
-->
<?import java.net.URL?>
<ScrollPane fx:id="rootScroll" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.Settings.SettingsController"
            styleClass="settings-screen,transparent-scroll"
            fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="@../../Theme/settings.css"/>
    </stylesheets>

    <VBox spacing="0">

        <!-- Header -->
        <VBox styleClass="page-header" spacing="4">
            <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>
            <Label text="Settings" styleClass="page-title"/>
            <Label text="Account, role, and app preferences."
                   styleClass="page-subtitle" wrapText="true"/>
        </VBox>

        <Separator/>

        <VBox spacing="20">
            <padding><Insets top="20" right="24" bottom="28" left="24"/></padding>

            <!-- Account section -->
            <VBox spacing="10" styleClass="settings-card">
                <Label text="Account" styleClass="settings-section-title"/>
                <Separator/>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="Signed in as" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="staffNameLabel" styleClass="settings-value"/>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="Organisation" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="organizationLabel" styleClass="settings-value"/>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="Staff ID" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="staffIdLabel" styleClass="settings-value"/>
                </HBox>
            </VBox>

            <!-- Active Role section -->
            <VBox spacing="10" styleClass="settings-card">
                <Label text="Active Role" styleClass="settings-section-title"/>
                <Separator/>

                <Label fx:id="currentRoleLabel" styleClass="settings-current-role"/>

                <Label fx:id="roleHintLabel"
                       text="Choose a different role to switch the dashboard. The app will reload to apply your choice."
                       styleClass="settings-hint" wrapText="true"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Switch to" styleClass="settings-label"/>
                    <ChoiceBox fx:id="roleChoice" prefWidth="220"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="switchStatusLabel" styleClass="settings-status"/>
                    <Button fx:id="switchButton"
                            text="Switch role"
                            onAction="#onSwitchRole"
                            styleClass="btn,btn-primary"
                            disable="true"/>
                </HBox>
            </VBox>

            <!-- About section -->
            <VBox spacing="10" styleClass="settings-card">
                <Label text="About" styleClass="settings-section-title"/>
                <Separator/>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="Version" styleClass="settings-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="versionLabel" styleClass="settings-value"/>
                </HBox>
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>