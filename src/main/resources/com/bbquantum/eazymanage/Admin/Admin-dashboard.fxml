                                </HBox>
                            </VBox>

                            <VBox fx:id="passwordResetBox"
                                  spacing="10"
                                  maxHeight="300"
                                  maxWidth="400"
                                  visible="false"
                                  managed="false"
                                  styleClass="sub-panel">
                                <Label text="Enter new password" styleClass="input-label"/>

                                <StackPane>
                                    <PasswordField fx:id="passwordField"
                                                   styleClass="enroll-input"/>

                                    <TextField fx:id="newPasswordField"
                                               styleClass="enroll-input"
                                               visible="false"
                                               managed="false"/>
                                </StackPane>

                                <Button text="Show Password" styleClass="action-button-mint"
                                        onAction="#handleShowPassword"/>

                                <Separator styleClass="content-separator"/>

                                <HBox spacing="10">
                                    <Button fx:id="okResetBtn"
                                            text="OK"
                                            styleClass="action-button-primary"
                                            onAction="#handleResetPassword"/>

                                    <Button text="CANCEL"
                                            styleClass="action-button-red"
                                            onAction="#handleCancelReset"/>
                                </HBox>
                            </VBox>
                        </StackPane>
                    </VBox>
                </ScrollPane>

                <ScrollPane fx:id="systemLogsView"
                            visible="false"
                            managed="false"
                            fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox spacing="30" styleClass="content-padding" alignment="CENTER">

                        <VBox alignment="CENTER">
                            <Label text="VIEW SYSTEM LOGS" styleClass="header-title"/>
                        </VBox>

                        <VBox fx:id="logsSearchArea"
                              spacing="10"
                              alignment="CENTER_LEFT"
                              maxWidth="700"
                              styleClass="sub-panel">
                            <Label text="Select fetch category for filtering activities"
                                   styleClass="input-label"/>

                            <HBox spacing="15" alignment="CENTER">
                                <VBox spacing="8" prefWidth="300">
                                    <Label text="Select Date *" styleClass="input-label"/>
                                    <DatePicker fx:id="filterDatePicker"
                                                maxWidth="Infinity"
                                                styleClass="modern-date-picker"/>
                                </VBox>

                                <VBox spacing="8" prefWidth="300">
                                    <Label text="Select Staff" styleClass="input-label"/>
                                    <ComboBox fx:id="filterStaffBox"
                                              promptText="Select staff for filtering"
                                              maxWidth="Infinity"
                                              styleClass="modern-combo"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8" alignment="CENTER_RIGHT">

                                <Button fx:id="fetchSystemLogsBtn"
                                        text="FETCH LOGS"
                                        onAction="#handleFetchLogs"
                                        styleClass="action-button-primary"/>
                            </VBox>
                        </VBox>

                        <StackPane fx:id="logsCardContainer">

                            <VBox fx:id="activitiesListPanel"
                                  spacing="20"
                                  styleClass="table-container-card">

                                <Label text="Filtered Activities" styleClass="section-title-small"/>

                                <Separator styleClass="content-separator"/>

                                <TableView fx:id="activitiesTable"
                                           prefHeight="500"
                                           styleClass="modern-table">
                                    <columns>
                                        <TableColumn text="ID" fx:id="filter_activitiesIdCol" prefWidth="120"/>
                                        <TableColumn text="TYPE" fx:id="filter_activityTypeCol" prefWidth="250"/>
                                        <TableColumn text="CREATED BY" fx:id="filter_createdByCol" prefWidth="120"/>
                                        <TableColumn text="DATE" fx:id="filter_activityDateCol" prefWidth="180"/>
                                        <TableColumn text="TIME" fx:id="filter_activityTimeCol" prefWidth="120"/>
                                        <TableColumn text="ACTION" fx:id="filter_actionDataCol" prefWidth="120"/>
                                        <TableColumn text="STATUS" fx:id="filter_activityStatusCol" prefWidth="120"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No Activities found"
                                               style="-fx-text-fill: #94A3B8;"/>
                                    </placeholder>
                                </TableView>
                            </VBox>

                            <VBox fx:id="viewLogDetailsPanel"
                                  spacing="25"
                                  visible="false"
                                  managed="false"
                                  styleClass="panel-card"
                                  maxWidth="700">

                                <HBox alignment="CENTER_LEFT"
                                      styleClass="sub-panel"
                                      spacing="15">
                                    <Button text="BACK"
                                            styleClass="back-nav-button"
                                            onAction="#backToLogsList"/>

                                    <Label text="LOG INFORMATION"
                                           styleClass="section-header-blue"/>
                                </HBox>

                                <HBox spacing="15">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Activity ID:" styleClass="section-title-small"/>
                                        <Label fx:id="activityIdField"
                                               styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Activity Date:" styleClass="section-title-small"/>
                                        <Label fx:id="activityDateField"
                                               styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Activity Time:" styleClass="section-title-small"/>
                                        <Label fx:id="activityTimeField"
                                               styleClass="section-title-small"/>
                                    </VBox>
                                </HBox>

                                <Separator styleClass="content-separator"/>

                                <HBox spacing="15">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Activity Type:" styleClass="section-title-small"/>
                                        <Label fx:id="activityTypeField"
                                               styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Created By:" styleClass="section-title-small"/>
                                        <Label fx:id="activityOwnerField"
                                               styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Activity Status:" styleClass="section-title-small"/>
                                        <Label fx:id="activityStatusField"
                                               styleClass="section-title-small"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="8" styleClass="sub-panel">
                                    <Label text="Activity Data:" styleClass="section-title-small"/>
                                    <TextArea fx:id="activityDataField"
                                              maxWidth="500"
                                              maxHeight="300"
                                              editable="false"
                                              styleClass="text-data"/>
                                </VBox>
                            </VBox>
                        </StackPane>
                    </VBox>
                </ScrollPane>

                <ScrollPane fx:id="manageSemesterView"
                            visible="false"
                            managed="false"
                            fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #DBEAFE;">
                                <Label text="🎓" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="MANAGE SEMESTERS" styleClass="header-title"/>
                            <Label text="Add or Update semester Data" styleClass="header-subtitle"/>
                        </VBox>

                        <!-- 🔘 TOGGLE BUTTONS -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="addSemesterToggleBtn"
                                    text="ADD SEMESTER"
                                    onAction="#showAddSemesterCard"
                                    styleClass="action-button-primary"/>

                            <Button fx:id="updateSemesterToggleBtn"
                                    text="UPDATE SEMESTER INFO"
                                    onAction="#showUpdateSemesterInfoCard"
                                    styleClass="action-button-primary"/>
                        </HBox>

                        <StackPane>

                            <VBox fx:id="addNewSemesterPanel"
                                  spacing="15"
                                  maxWidth="700"
                                  styleClass="panel-card"
                                  alignment="CENTER">

                                <VBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Enter Semester Name" styleClass="input-label"/>
                                    <TextField fx:id="semesterNameField"
                                               promptText="eg. First_Term"
                                               styleClass="modern-input"/>
                                </VBox>

                                <HBox spacing="10" alignment="CENTER_LEFT">

                                    <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">

                                        <Label text="Select Start Date" styleClass="input-label"/>
                                        <DatePicker fx:id="semesterStartDate"
                                                   promptText="eg. 1/8/2026"
                                                   styleClass="modern-input"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">

                                        <Label text="Select End Date" styleClass="input-label"/>
                                        <DatePicker fx:id="semesterEndDate"
                                                   promptText="eg. 1/8/2026"
                                                   styleClass="modern-input"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Enter Academic year" styleClass="input-label"/>
                                    <TextField fx:id="semesterAcademicYearField"
                                               promptText="eg. 2025/2026"
                                               styleClass="modern-date-picker"/>
                                </VBox>

                                <VBox spacing="8" alignment="CENTER_RIGHT">

                                    <Button fx:id="addSemesterBtn"
                                            text="ADD SEMESTER"
                                            onAction="#handleAddSemester"
                                            styleClass="action-button-primary"/>
                                </VBox>
                            </VBox>

                            <VBox fx:id="updateSemesterPanel"
                                  spacing="15"
                                  maxWidth="700"
                                  styleClass="panel-card"
                                  alignment="CENTER">

                                <VBox fx:id="updateSemesterSearchBox"
                                      spacing="10"
                                      alignment="CENTER_LEFT">

                                    <Label text="Select semester" styleClass="input-label"/>
                                    <ComboBox fx:id="semester_searchInfoBox"
                                              promptText="Select Semester"
                                              maxWidth="Infinity"
                                              styleClass="modern-combo"/>

                                    <VBox spacing="8" alignment="CENTER_RIGHT">

                                        <Button fx:id="update_searchSemesterBtn"
                                                text="FETCH DATA"
                                                onAction="#handleFetchSemesterData"
                                                styleClass="action-button-primary"/>
                                    </VBox>
                                </VBox>

                                <VBox fx:id="updateSemesterResponsePanel"
                                      visible="false"
                                      managed="false"
                                      maxWidth="700"
                                      spacing="10"
                                      alignment="CENTER">

                                    <VBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="Semester ID" styleClass="input-label"/>
                                        <Label fx:id="updateSemesterIdLabel"
                                                   styleClass="section-title-small"/>
                                    </VBox>

                                    <VBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="Enter Semester Name" styleClass="input-label"/>
                                        <TextField fx:id="updateSemesterNameField"
                                                   promptText="eg. First_Term"
                                                   styleClass="modern-input"/>
                                    </VBox>

                                    <HBox spacing="10" alignment="CENTER_LEFT">

                                        <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">

                                            <Label text="Select Start Date" styleClass="input-label"/>
                                            <DatePicker fx:id="updateSemesterStartDate"
                                                       promptText="eg. 1/8/2026"
                                                       styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">

                                            <Label text="Select End Date" styleClass="input-label"/>
                                            <DatePicker fx:id="updateSemesterEndDate"
                                                       promptText="eg. 1/8/2026"
                                                       styleClass="modern-input"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="Enter Academic year" styleClass="input-label"/>
                                        <TextField fx:id="updateSemesterAcademicYearField"
                                                   promptText="eg. 2025/2026"
                                                   styleClass="modern-date-picker"/>
                                    </VBox>

                                    <VBox spacing="10" alignment="CENTER_RIGHT">

                                        <Button text="CLOSE PANEL"
                                                onAction="#handleCancelSemesterUpdate"
                                                styleClass="action-button-red"/>

                                        <Button fx:id="updateSemesterBtn"
                                                text="SAVE CHANGES"
                                                onAction="#handleUpdateSemester"
                                                styleClass="action-button-primary"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </StackPane>
                    </VBox>
                </ScrollPane>


                <!-- LOADING OVERLAY -->
                <VBox fx:id="loadingOverlay"
                      alignment="CENTER"
                      spacing="15"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(0,0,0,0.3);">

                    <ProgressIndicator fx:id="loadingSpinner"
                                       style="-fx-text-fill: #4682B4;"/>

                    <Label text="Loading dashboard..."
                           style="-fx-text-fill: #4682B4; -fx-font-size: 14;" />
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
