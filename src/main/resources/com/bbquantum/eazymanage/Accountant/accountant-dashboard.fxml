<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.FinanceController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background: #f5f7fa; -fx-background-color: #f5f7fa;">

    <HBox style="-fx-background-color: transparent;">

        <!-- LEFT SIDEBAR - Navigation -->
        <VBox spacing="0" style="-fx-background-color: #2c3e50; -fx-min-width: 250; -fx-pref-width: 250;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 30 20 30 20; -fx-background-color: #1a252f;">
                <Label text="💰" style="-fx-font-size: 40px;"/>
                <Label text="EAZY MANAGE" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Accountant Portal" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
            </VBox>

            <Separator style="-fx-background-color: #34495e;"/>

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 20 10 20 10;">

                <!-- Dashboard Button -->
                <Button fx:id="dashboardBtn" text="📊 Dashboard" onAction="#showDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand;">
                </Button>

                <!-- Add Semester Fees Button -->
                <Button fx:id="addFeesBtn" text="➕ Add Semester Fees" onAction="#showAddFees"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>

                <!-- Record Payment Button -->
                <Button fx:id="recordPaymentBtn" text="💵 Record Payment" onAction="#showRecordPayment"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>

                <!-- Search Report Button -->
                <Button fx:id="searchReportBtn" text="🔍 Search Report" onAction="#showSearchReport"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Info & Logout -->
            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #1a252f;">
                <Separator style="-fx-background-color: #34495e;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 24px;"/>
                    <VBox spacing="2">
                        <Label fx:id="institutionNameLabel" text="Accountant Name" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="accountantNameLabel" text="School Name" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand;">
                </Button>
            </VBox>
        </VBox>

        <!-- RIGHT CONTENT AREA -->
        <StackPane fx:id="contentArea" style="-fx-background-color: #f5f7fa;" HBox.hgrow="ALWAYS">

            <!-- MAIN DASHBOARD VIEW -->
            <ScrollPane fx:id="dashboardView" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="25" style="-fx-padding: 30;">

                    <!-- Header -->
                    <VBox spacing="5">
                        <Label text="Accountant Dashboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label fx:id="dateTimeLabel" text="Monday, November 25, 2025 | 2:30 PM" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <!-- Financial Summary Cards -->
                    <HBox spacing="20">
                        <!-- Total Semester Fees -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="💵" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Total Semester Fees" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="totalFeesLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                            </HBox>
                            <Label text="Expected revenue for current semester" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>

                        <!-- Amount Paid -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="✅" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Amount Paid" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="amountPaidLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="percentageLabel" text="0%" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                    <Label text="collected" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                                </HBox>
                                <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity" style="-fx-accent: #27ae60;"/>
                            </VBox>
                        </VBox>

                        <!-- Outstanding -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                              HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="⏳" style="-fx-font-size: 40px;"/>
                                <VBox spacing="5">
                                    <Label text="Outstanding" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="outstandingLabel" text="GH₵ 0.00" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                </VBox>
                            </HBox>
                            <Label text="Pending payments" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                        </VBox>
                    </HBox>

                    <!-- Quick Action Buttons -->
                    <GridPane hgap="20" vgap="20">

                        <!-- Add Fees Card -->
                        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                              GridPane.columnIndex="0" GridPane.rowIndex="0" onMouseClicked="#showAddFees">
                            <Label text="➕" style="-fx-font-size: 48px;"/>
                            <Label text="Add Semester Fees" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Set fees for classes" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                        </VBox>

                        <!-- Record Payment Card -->
                        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" onMouseClicked="#showRecordPayment">
                            <Label text="💵" style="-fx-font-size: 48px;"/>
                            <Label text="Record Payment" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Add payment details" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                        </VBox>

                        <!-- Search Report Card -->
                        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                              GridPane.columnIndex="2" GridPane.rowIndex="0" onMouseClicked="#showSearchReport">
                            <Label text="🔍" style="-fx-font-size: 48px;"/>
                            <Label text="Search Report" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="View payment history" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                        </VBox>
                    </GridPane>

                    <!-- Recent Payments Table -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="💳 Recent Payments" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Refresh" onAction="#refreshDashboard"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator/>

                        <TableView fx:id="recentPaymentsTable" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn text="Date" prefWidth="120" fx:id="paymentDateCol"/>
                                <TableColumn text="Student ID" prefWidth="120" fx:id="studentIdCol"/>
                                <TableColumn text="Student Name" prefWidth="180" fx:id="studentNameCol"/>
                                <TableColumn text="Amount" prefWidth="120" fx:id="amountCol"/>
                                <TableColumn text="Payer" prefWidth="150" fx:id="payerCol"/>
                                <TableColumn text="Grade" prefWidth="120" fx:id="gradeCol"/>
                            </columns>
                            <placeholder>
                                <Label text="No recent payments" style="-fx-text-fill: #95a5a6;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ADD SEMESTER FEES VIEW -->
            <ScrollPane fx:id="addSemesterFees" visible="false" managed="false" fitToWidth="true"
                        style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">

                <VBox alignment="TOP_CENTER" spacing="25">
                    <padding>
                        <Insets bottom="50.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>

                    <!-- Header -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="➕" style="-fx-font-size: 48px;"/>
                        <Label text="ADD SEMESTER FEES" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Set fees for different classes" style="-fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                    </VBox>

                    <!-- Form -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;" maxWidth="500">
                        <effect>
                            <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
                        </effect>

                        <Label text="Fee Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

                        <!-- Fees Amount -->
                        <VBox spacing="8">
                            <Label text="Fees Amount *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <TextField fx:id="feesAmountField" promptText="Enter amount (e.g., 3500.00)"
                                       style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        </VBox>

                        <!-- Semester Selection -->
                        <VBox spacing="8">
                            <Label text="Semester *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <ComboBox fx:id="feesAddSemesterComboBox" promptText="Select Semester" maxWidth="Infinity"
                                      style="-fx-font-size: 14px;"/>
                        </VBox>

                        <!-- Class Selection -->
                        <VBox spacing="8">
                            <Label text="Class/Level *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <ComboBox fx:id="feesAddClassComboBox" promptText="Select Class" maxWidth="Infinity"
                                      style="-fx-font-size: 14px;"/>
                        </VBox>

                        <Separator style="-fx-padding: 10 0 10 0;"/>

                        <!-- Action Buttons -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="💾 Save and Clear" onAction="#handleSaveAndClear"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                <effect>
                                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                </effect>
                            </Button>

                            <Button text="💾 Save and Close" onAction="#handleSaveAndClose"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                <effect>
                                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                </effect>
                            </Button>
                        </HBox>

                        <!-- Help Text -->
                        <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 8; -fx-padding: 15;">
                            <Label text="💡 Quick Tips:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label text="• Click 'Save and Clear' to add fees for multiple classes quickly"
                                   style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <Label text="• Click 'Save and Close' to save and return to dashboard"
                                   style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </VBox>
                </VBox>

            </ScrollPane>

            <!-- RECORD PAYMENT VIEW -->
            <ScrollPane fx:id="recordNewPayment" visible="false" managed="false" fitToWidth="true"
                        style="-fx-background: linear-gradient(to bottom, #f093fb 0%, #f5576c 100%);">

                <VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="50.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>

                    <!-- Header -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="💵" style="-fx-font-size: 48px;"/>
                        <Label text="RECORD PAYMENT" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Add student payment details" style="-fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                    </VBox>

                    <!-- Form -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;" maxWidth="550">
                        <effect>
                            <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
                        </effect>

                        <!-- Student Information Section -->
                        <Label text="Student Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f5576c;"/>

                        <!-- Student ID -->
                        <VBox spacing="8">
                            <Label text="Student ID *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <TextField fx:id="studentIdField" promptText="Enter Student ID"
                                       style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        </VBox>

                        <!-- Semester and Class -->
                        <HBox spacing="15">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Semester *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="recordPaymentSemesterComboBox" promptText="Select Semester" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Class/Level *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="recordPaymentClassComboBox" promptText="Select Class" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>
                        </HBox>

                        <Separator style="-fx-padding: 10 0 10 0;"/>

                        <!-- Payment Information Section -->
                        <Label text="Payment Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f5576c;"/>

                        <!-- Amount Paid -->
                        <VBox spacing="8">
                            <Label text="Amount Paid *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <TextField fx:id="amountPaidField" promptText="Enter amount paid (e.g., 2000.00)"
                                       style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        </VBox>

                        <!-- Person Who Paid -->
                        <VBox spacing="8">
                            <Label text="Person Who Paid *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <TextField fx:id="payerNameField" promptText="Enter name of person who paid"
                                       style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        </VBox>

                        <!-- Payer Phone Number -->
                        <VBox spacing="8">
                            <Label text="Payer's Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                            <TextField fx:id="payerPhoneField" promptText="0XX XXX XXXX"
                                       style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        </VBox>
                        <Separator style="-fx-padding: 10 0 10 0;"/>

                        <!-- Action Buttons -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="💾 Save &amp; Clear" onAction="#handleSaveAndClearPayment"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                <effect>
                                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                </effect>
                            </Button>

                            <Button text="💾 Save &amp; Close" onAction="#handleSaveAndClosePayment"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                                <effect>
                                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                </effect>
                            </Button>
                        </HBox>

                        <!-- Help Text -->
                        <VBox spacing="5" style="-fx-background-color: #fff3cd; -fx-background-radius: 8; -fx-padding: 15;">
                            <Label text="💡 Quick Tips:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Label text="• Click 'Save &amp; Clear' to record payments for multiple students quickly"
                                   style="-fx-font-size: 11px; -fx-text-fill: #856404;"/>
                            <Label text="• Click 'Save &amp; Close' to save and return to dashboard"
                                   style="-fx-font-size: 11px; -fx-text-fill: #856404;"/>
                            <Label text="• Payment date will default to today if not specified"
                                   style="-fx-font-size: 11px; -fx-text-fill: #856404;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>


            <!-- SEARCH STUDENT REPORT VIEW -->
            <ScrollPane fx:id="searchStudentReportView" visible="false" managed="false" fitToWidth="true"
                        style="-fx-background: linear-gradient(to bottom, #4facfe 0%, #00f2fe 100%);">

                <VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="50.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>

                    <!-- Header -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="🔍" style="-fx-font-size: 48px;"/>
                        <Label text="SEARCH PAYMENT REPORTS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="View student payment history" style="-fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                    </VBox>

                    <!-- Search Form -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;" maxWidth="800">
                        <effect>
                            <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
                        </effect>

                        <Label text="Search Criteria" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00f2fe;"/>

                        <Separator/>

                        <!-- Search Filters -->
                        <GridPane hgap="15" vgap="15">

                            <!-- Student ID -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Student ID *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <TextField fx:id="reportSearchStudentIdField" promptText="Enter Student ID"
                                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                            </VBox>

                            <!-- Semester -->
                            <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Semester" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="reportSearchSemesterComboBox" promptText="Select Semester" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>

                            <!-- Class -->
                            <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Class/Level" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                                <ComboBox fx:id="reportSearchClassComboBox" promptText="Select Class" maxWidth="Infinity"
                                          style="-fx-font-size: 14px;"/>
                            </VBox>
                        </GridPane>

                        <!-- Search Button -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="searchFeesReportBtn" text="🔍 Search Report" onAction="#handleSearch"
                                    style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 8; -fx-cursor: hand;">
                                <effect>
                                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                                </effect>
                            </Button>
                            <Button text="🔄 Clear Report" onAction="#handleClear"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator style="-fx-padding: 10 0 10 0;"/>

                        <!-- Report Search Results Panel (Hidden by default) -->
                        <VBox fx:id="reportResponsePanel" spacing="20" visible="false" managed="false">

                            <!-- Student Info Header -->
                            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #e8f4f8; -fx-background-radius: 10; -fx-padding: 20;">
                                <Label text="🎓" style="-fx-font-size: 32px;"/>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label fx:id="reportResponseStudentNameLabel" text="Student Name" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                    <HBox spacing="15">
                                        <Label fx:id="reportResponseStudentIdLabel" text="ID: STU001" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                        <Label text="•" style="-fx-text-fill: #7f8c8d;"/>
                                        <Label fx:id="reportResponseClassLabel" text="Class: Form 1A" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                        <Label text="•" style="-fx-text-fill: #7f8c8d;"/>
                                        <Label fx:id="reportResponseSemesterLabel" text="Semester: 1st" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- Payment Summary -->
                            <GridPane hgap="20" vgap="15">

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Total Fees" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="reportResponseTotalFeeLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Amount Paid" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="reportResponseAmountPaidLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="OutStanding" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="reportResponseBalanceLabel" text="GH₵ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                </VBox>
                            </GridPane>

                            <!-- Progress Bar -->
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Payment Progress:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                    <Label fx:id="reportResponsePercentageLabel" text="0%" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                </HBox>
                                <ProgressBar fx:id="reportResponseProgressBar" progress="0.0" maxWidth="Infinity" style="-fx-accent: #27ae60; -fx-pref-height: 15;"/>
                            </VBox>

                            <!-- Payment History Table -->
                            <VBox spacing="10">
                                <Label text="Payment History" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                <TableView fx:id="paymentHistoryTable" style="-fx-background-color: transparent;">
                                    <columns>
                                        <TableColumn text="Date" prefWidth="120" fx:id="dateColumn"/>
                                        <TableColumn text="Amount" prefWidth="120" fx:id="amountColumn"/>
                                        <TableColumn text="Fees Balance" prefWidth="120" fx:id="feesBalanceColumn"/>
                                        <TableColumn text="Payer Name" prefWidth="150" fx:id="payerNameColumn"/>
                                        <TableColumn text="Payer Phone" prefWidth="130" fx:id="payerPhoneColumn"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No payment records" style="-fx-text-fill: #95a5a6;"/>
                                    </placeholder>
                                </TableView>
                            </VBox>

                            <!-- Action Buttons -->
                            <HBox spacing="15" alignment="CENTER_RIGHT">
                                <Button text="📄 Print Report" onAction="#handlePrint"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                                <Button text="📧 Email Report" onAction="#handleEmail"
                                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                                <Button text="📥 Export Excel" onAction="#handleExport"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 10 20 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- No Results Panel (Hidden by default) -->
                        <VBox fx:id="noResponsePanel" spacing="10" alignment="CENTER" visible="false" managed="false"
                              style="-fx-background-color: #fff3cd; -fx-background-radius: 8; -fx-padding: 30;">
                            <Label text="⚠️" style="-fx-font-size: 48px;"/>
                            <Label text="No Payment Records Found" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #856404;"/>
                            <Label text="No payment records found for the selected criteria" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

        </StackPane>
    </HBox>


</ScrollPane>