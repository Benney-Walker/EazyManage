<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.FinanceController"
            fx:id="notification">

    <BorderPane styleClass="principal-root">
        <stylesheets>
            <URL value="@../Styles/Styles.css"/>
        </stylesheets>

        <!-- LEFT SIDEBAR - Navigation -->
        <left>
            <VBox prefWidth="250" minWidth="250" styleClass="sidebar">

                <VBox alignment="CENTER" spacing="10" styleClass="sidebar-header">
                    <StackPane styleClass="sidebar-logo-bg">
                        <Label text="💰" style="-fx-font-size: 28px;"/>
                    </StackPane>
                    <Label text="EAZY MANAGE" styleClass="brand-name"/>
                    <Label text="V 2.0.0" styleClass="version-badge"/>
                </VBox>

                <Separator styleClass="sidebar-separator"/>

                <VBox spacing="8" styleClass="nav-container">

                    <Button fx:id="dashboardBtn" text="📊 Dashboard" onAction="#showDashboard"
                            maxWidth="Infinity"
                            styleClass="nav-button, nav-button-active"/>

                    <Button fx:id="addFeesBtn" text="➕ Add Semester Fees" onAction="#showAddFees"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>

                    <Button fx:id="recordPaymentBtn" text="💵 Record Payment" onAction="#showRecordPayment"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>

                    <Button fx:id="searchReportBtn" text="🔍 Search Report" onAction="#showSearchReport"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="15" styleClass="sidebar-footer">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane styleClass="avatar-circle-small">
                            <Label text="👤" style="-fx-font-size: 16px;"/>
                        </StackPane>
                        <VBox spacing="1">
                            <Label fx:id="institutionNameLabel" text="School Name" styleClass="user-label-bold"/>
                            <Label fx:id="accountantNameLabel" text="Accountant Name" styleClass="user-label-sub"/>
                        </VBox>
                    </HBox>

                    <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity"
                            styleClass="logout-button"/>
                </VBox>
            </VBox>
        </left>

        <center>
            <!-- RIGHT CONTENT AREA -->
            <StackPane fx:id="contentArea" styleClass="main-content-bg">

                <!-- MAIN DASHBOARD -->
                <ScrollPane fx:id="dashboardView" fitToWidth="true" styleClass="modern-scroll-pane">
                    <VBox spacing="30" styleClass="content-padding">

                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="5">
                                <Label text="Accountant Dashboard" styleClass="header-title"/>
                                <Label fx:id="dateTimeLabel" text="Monday, December 30, 2025 | 2:30 PM" styleClass="header-subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <HBox spacing="20">
                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="💵" styleClass="card-icon-bg-blue"/>
                                    <VBox spacing="5">
                                        <Label text="Total Semester Fees" styleClass="card-label"/>
                                        <Label fx:id="totalFeesLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>
                                </HBox>
                                <Label text="Expected revenue for current semester" styleClass="card-footer-text"/>
                            </VBox>

                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="✅" styleClass="card-icon-bg-mint"/>
                                    <VBox spacing="5">
                                        <Label text="Amount Paid" styleClass="card-label"/>
                                        <Label fx:id="amountPaidLabel" text="GH₵ 0.00" styleClass="card-value-mint"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="percentageLabel" text="0%" style="-fx-font-weight: bold; -fx-text-fill: -accent-mint;"/>
                                        <Label text="of total collected" styleClass="card-footer-text"/>
                                    </HBox>
                                    <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar"/>
                                </VBox>
                            </VBox>

                            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <Label text="⏳" styleClass="card-icon-bg-red"/>
                                    <VBox spacing="5">
                                        <Label text="Outstanding" styleClass="card-label"/>
                                        <Label fx:id="outstandingLabel" text="GH₵ 0.00" styleClass="card-value-red"/>
                                    </VBox>
                                </HBox>
                                <Label text="Total pending student payments" styleClass="card-footer-text"/>
                            </VBox>
                        </HBox>

                        <GridPane hgap="20" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3"/>
                            </columnConstraints>

                            <VBox styleClass="card-action-purple" alignment="CENTER" spacing="12"
                                  GridPane.columnIndex="0" onMouseClicked="#showAddFees">
                                <Label text="➕" styleClass="action-card-icon"/>
                                <Label text="Add Semester Fees" styleClass="action-card-title"/>
                                <Label text="Set fees for specific classes" styleClass="action-card-subtitle"/>
                            </VBox>

                            <VBox styleClass="card-action-pink" alignment="CENTER" spacing="12"
                                  GridPane.columnIndex="1" onMouseClicked="#showRecordPayment">
                                <Label text="💵" styleClass="action-card-icon"/>
                                <Label text="Record Payment" styleClass="action-card-title"/>
                                <Label text="Update student fee status" styleClass="action-card-subtitle"/>
                            </VBox>

                            <VBox styleClass="card-action-cyan" alignment="CENTER" spacing="12"
                                  GridPane.columnIndex="2" onMouseClicked="#showSearchReport">
                                <Label text="🔍" styleClass="action-card-icon"/>
                                <Label text="Search Report" styleClass="action-card-title"/>
                                <Label text="View audit history" styleClass="action-card-subtitle"/>
                            </VBox>
                        </GridPane>

                        <VBox spacing="20" styleClass="stat-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="💳 Recent Transactions" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="refreshBtn" text="Refresh Table" onAction="#refreshDashboard" styleClass="text-button-blue"/>
                            </HBox>

                            <Separator styleClass="content-separator"/>

                            <TableView fx:id="recentPaymentsTable" styleClass="modern-table" prefHeight="350">
                                <columns>
                                    <TableColumn text="Date" fx:id="paymentDateCol" prefWidth="150"/>
                                    <TableColumn text="Student ID" fx:id="studentIdCol" prefWidth="120"/>
                                    <TableColumn text="Student Name" fx:id="studentNameCol" prefWidth="200"/>
                                    <TableColumn text="Amount (GH₵)" fx:id="amountCol" prefWidth="130"/>
                                    <TableColumn text="Payer Name" fx:id="payerCol" prefWidth="150"/>
                                    <TableColumn text="Grade" fx:id="gradeCol" prefWidth="100"/>
                                </columns>
                                <placeholder>
                                    <Label text="No transactions recorded in this period." style="-fx-text-fill: #94A3B8;"/>
                                </placeholder>
                            </TableView>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- ADD SEMESTER FEES VIEW -->
                <ScrollPane fx:id="addSemesterFees" visible="false" managed="false" fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #ECFDF5;">
                                <Label text="➕" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="ADD SEMESTER FEES" styleClass="header-title"/>
                            <Label text="Set financial requirements for the current academic term" styleClass="header-subtitle"/>
                        </VBox>

                        <VBox spacing="25" styleClass="panel-card" maxWidth="550">

                            <Label text="Fee Configuration" styleClass="section-header-blue"/>

                            <VBox spacing="20">
                                <VBox spacing="8">
                                    <Label text="Amount (GH₵) *" styleClass="input-label"/>
                                    <TextField fx:id="feesAmountField" promptText="e.g. 3500.00" styleClass="modern-input"/>
                                </VBox>

                                <HBox spacing="15">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Semester *" styleClass="input-label"/>
                                        <ComboBox fx:id="feesAddSemesterComboBox" promptText="Select Term" maxWidth="Infinity" styleClass="modern-combo"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Class/Level *" styleClass="input-label"/>
                                        <ComboBox fx:id="feesAddClassComboBox" promptText="Select Level" maxWidth="Infinity" styleClass="modern-combo"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <Separator styleClass="content-separator"/>

                            <HBox spacing="15" alignment="CENTER">
                                <Button fx:id="saveFeesBtn" text="💾 Save &amp; Clear" onAction="#handleSaveAndClear"
                                        styleClass="action-button-mint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>

                            <VBox spacing="8" styleClass="alert-panel-info">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="💡" style="-fx-font-size: 14px;"/>
                                    <Label text="Pro-Tips for Accountants" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12px;"/>
                                </HBox>
                                <Label text="• Use 'Save &amp; Add Another' to quickly cycle through different grade levels."
                                       styleClass="login-footer-label" wrapText="true"/>
                                <Label text="• Ensure the amount is verified before saving to avoid bulk billing errors."
                                       styleClass="login-footer-label" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- RECORD PAYMENT VIEW -->
                <ScrollPane fx:id="recordNewPayment" visible="false" managed="false" fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #FEF3C7;">
                                <Label text="💵" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="RECORD PAYMENT" styleClass="header-title"/>
                            <Label text="Log incoming tuition and school fees" styleClass="header-subtitle"/>
                        </VBox>

                        <VBox spacing="25" styleClass="panel-card" maxWidth="600">

                            <VBox spacing="15">
                                <Label text="Student Details" styleClass="section-header-blue"/>
                                <VBox spacing="8">
                                    <Label text="Student ID *" styleClass="input-label"/>
                                    <TextField fx:id="studentIdField" promptText="Enter Student ID" styleClass="modern-input"/>
                                </VBox>

                                <HBox spacing="15">
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Semester *" styleClass="input-label"/>
                                        <ComboBox fx:id="recordPaymentSemesterComboBox" promptText="Select Term" maxWidth="Infinity" styleClass="modern-combo"/>
                                    </VBox>

                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <Label text="Class/Level *" styleClass="input-label"/>
                                        <ComboBox fx:id="recordPaymentClassComboBox" promptText="Select Level" maxWidth="Infinity" styleClass="modern-combo"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <Separator styleClass="content-separator"/>

                            <VBox spacing="15">
                                <Label text="Transaction Details" styleClass="section-header-blue"/>

                                <VBox spacing="8">
                                    <Label text="Amount Paid (GH₵) *" styleClass="input-label"/>
                                    <TextField fx:id="amountPaidField" promptText="e.g. 2000.00" styleClass="modern-input"/>
                                </VBox>

                                <GridPane hgap="15" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="60"/>
                                        <ColumnConstraints percentWidth="40"/>
                                    </columnConstraints>

                                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Person Who Paid *" styleClass="input-label"/>
                                        <TextField fx:id="payerNameField" promptText="Parent/Guardian Name" styleClass="modern-input"/>
                                    </VBox>

                                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Payer's Phone *" styleClass="input-label"/>
                                        <TextField fx:id="payerPhoneField" promptText="0XXXXXXXXX" styleClass="modern-input"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <Separator styleClass="content-separator"/>

                            <HBox spacing="15" alignment="CENTER">
                                <Button text="💾 Save &amp; Add Another" onAction="#handleSaveAndClearPayment"
                                        styleClass="action-button-mint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>

                            <VBox spacing="8" styleClass="alert-panel-warning">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="⚠️" style="-fx-font-size: 14px;"/>
                                    <Label text="Important Note" style="-fx-font-weight: bold; -fx-text-fill: #92400E; -fx-font-size: 12px;"/>
                                </HBox>
                                <Label text="• Payments are timestamped automatically. Ensure the Student ID is correct to avoid misallocation of funds."
                                       styleClass="login-footer-label" style="-fx-text-fill: #92400E;" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>


                <!-- SEARCH STUDENT REPORT VIEW -->
                <ScrollPane fx:id="searchStudentReportView" visible="false" managed="false" fitToWidth="true"
                            styleClass="modern-scroll-pane">

                    <VBox alignment="TOP_CENTER" spacing="30" styleClass="content-padding">

                        <VBox alignment="CENTER" spacing="10">
                            <StackPane styleClass="sidebar-logo-bg" style="-fx-background-color: #E0F2FE;">
                                <Label text="🔍" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <Label text="PAYMENT AUDIT &amp; REPORTS" styleClass="header-title"/>
                            <Label text="Search student financial history and generate statements" styleClass="header-subtitle"/>
                        </VBox>

                        <VBox spacing="25" styleClass="panel-card" maxWidth="900">
                            <Label text="Filter Criteria" styleClass="section-header-blue"/>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="40"/>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="30"/>
                                </columnConstraints>

                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Student ID *" styleClass="input-label"/>
                                    <TextField fx:id="reportSearchStudentIdField" promptText="Enter Student ID" styleClass="modern-input"/>
                                </VBox>

                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Semester" styleClass="input-label"/>
                                    <ComboBox fx:id="reportSearchSemesterComboBox" promptText="All Semesters" maxWidth="Infinity" styleClass="modern-combo"/>
                                </VBox>

                                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label text="Class/Level" styleClass="input-label"/>
                                    <ComboBox fx:id="reportSearchClassComboBox" promptText="All Classes" maxWidth="Infinity" styleClass="modern-combo"/>
                                </VBox>
                            </GridPane>

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Button fx:id="searchFeesReportBtn" text="🔍 Search Report" onAction="#handleSearchFeesReport"
                                        styleClass="action-button-primary" style="-fx-padding: 12 40;"/>
                                <Button text="Reset Filters" onAction="#handleClear"
                                        styleClass="text-button-blue" style="-fx-font-size: 14px;"/>
                            </HBox>

                            <Separator styleClass="content-separator"/>

                            <VBox fx:id="reportResponsePanel" spacing="25" visible="false" managed="false">

                                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="alert-panel-info" style="-fx-padding: 20;">
                                    <StackPane styleClass="avatar-circle-small" style="-fx-min-width: 60; -fx-min-height: 60;">
                                        <Label text="🎓" style="-fx-font-size: 30px;"/>
                                    </StackPane>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label fx:id="reportResponseStudentNameLabel" text="Student Name" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                        <HBox spacing="15">
                                            <Label fx:id="reportResponseStudentIdLabel" text="ID: STU001" styleClass="sidebar-school-name"/>
                                            <Label text="|" style="-fx-text-fill: #CBD5E1;"/>
                                            <Label fx:id="reportResponseClassLabel" text="Class: Form 1A" styleClass="sidebar-school-name"/>
                                            <Label text="|" style="-fx-text-fill: #CBD5E1;"/>
                                            <Label fx:id="reportResponseSemesterLabel" text="Semester: 1st" styleClass="sidebar-school-name"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <HBox spacing="20">
                                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="Total Fees" styleClass="card-label"/>
                                        <Label fx:id="reportResponseTotalFeeLabel" text="GH₵ 0.00" styleClass="card-value"/>
                                    </VBox>

                                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="Total Paid" styleClass="card-label"/>
                                        <Label fx:id="reportResponseAmountPaidLabel" text="GH₵ 0.00" styleClass="card-value-mint"/>
                                    </VBox>

                                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label text="Outstanding Balance" styleClass="card-label"/>
                                        <Label fx:id="reportResponseBalanceLabel" text="GH₵ 0.00" styleClass="card-value-red"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="10" styleClass="stat-card">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Payment Completion:" styleClass="card-label"/>
                                        <Label fx:id="reportResponsePercentageLabel" text="0%" style="-fx-font-weight: bold; -fx-text-fill: -accent-mint;"/>
                                    </HBox>
                                    <ProgressBar fx:id="reportResponseProgressBar" progress="0.0" maxWidth="Infinity" styleClass="modern-progress-bar" style="-fx-pref-height: 12;"/>
                                </VBox>

                                <VBox spacing="15">
                                    <Label text="Transaction Ledger" styleClass="section-title"/>
                                    <TableView fx:id="paymentHistoryTable" styleClass="modern-table" prefHeight="300">
                                        <columns>
                                            <TableColumn text="Date" fx:id="dateColumn" prefWidth="130"/>
                                            <TableColumn text="Amount" fx:id="amountColumn" prefWidth="130"/>
                                            <TableColumn text="New Balance" fx:id="feesBalanceColumn" prefWidth="130"/>
                                            <TableColumn text="Payer Name" fx:id="payerNameColumn" prefWidth="180"/>
                                            <TableColumn text="Contact" fx:id="payerPhoneColumn" prefWidth="140"/>
                                        </columns>
                                        <placeholder>
                                            <Label text="No individual payments found for this criteria."/>
                                        </placeholder>
                                    </TableView>
                                </VBox>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button fx:id="printFeesReportBtn" text="Print Statement" onAction="#handlePrint" styleClass="text-button-blue"/>
                                    <Button text="Export Excel" onAction="#handleExport" styleClass="action-button-mint"/>
                                </HBox>
                            </VBox>

                            <VBox fx:id="noResponsePanel" spacing="15" alignment="CENTER" visible="false" managed="false" styleClass="alert-panel-warning">
                                <Label text="⚠️" style="-fx-font-size: 32px;"/>
                                <VBox alignment="CENTER" spacing="5">
                                    <Label text="No Records Found" style="-fx-font-weight: bold; -fx-text-fill: #92400E;"/>
                                    <Label text="We couldn't find any financial records matching those filters." style="-fx-text-fill: #92400E; -fx-font-size: 12px;"/>
                                </VBox>
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- LOADING OVERLAY -->
                <VBox fx:id="loadingOverlay"
                      alignment="CENTER"
                      spacing="15"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(0,0,0,0.35);">

                    <ProgressIndicator fx:id="loadingSpinner" />

                    <Label text="Loading dashboard..."
                           style="-fx-text-fill: white; -fx-font-size: 14;" />
                </VBox>
            </StackPane>
        </center>
    </BorderPane>

</StackPane>