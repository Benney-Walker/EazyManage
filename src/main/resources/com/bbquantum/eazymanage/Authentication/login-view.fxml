<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.LoginController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background: linear-gradient(to bottom, #667eea 0%, #764ba2 100%); -fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">

    <VBox alignment="CENTER" spacing="25.0"
          style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="50.0" left="40.0" right="40.0" top="50.0"/>
        </padding>

        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎓" style="-fx-font-size: 48px;"/>
            <Label text="EAZY MANAGE" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="School Management System" style="-fx-font-size: 16px; -fx-text-fill: #e0e0e0;"/>
            <Label text="Login to your account" style="-fx-font-size: 14px; -fx-text-fill: #ffffff; -fx-padding: 10 0 0 0;"/>
        </VBox>

        <!-- Login Form -->
        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40;" maxWidth="450">
            <effect>
                <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
            </effect>

            <!-- Staff ID Field -->
            <VBox spacing="8">
                <Label text="Staff ID" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="usernameField" promptText="Enter your Staff ID"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8">
                <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #dc3545; -fx-font-weight: bold; -fx-padding: 5;" visible="false"/>

            <!-- Login Button -->
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;">
                <effect>
                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                </effect>
            </Button>

            <Separator style="-fx-padding: 5 0 5 0;"/>

            <!-- Links Section -->
            <VBox alignment="CENTER" spacing="10">
                <Hyperlink text="New Staff? Enroll Here" onAction="#handleEnrollNewStaff"
                           style="-fx-text-fill: #667eea; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <VBox alignment="CENTER" spacing="5">
                    <Label text="New School?" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    <Hyperlink text="Subscribe Your Institution" onAction="#handleNewSchoolSubscription"
                               style="-fx-text-fill: #667eea; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- Footer -->
        <Label text="© 2025 BBQuantum | Empowering Education"
               style="-fx-font-size: 11px; -fx-text-fill: white;">
            <padding>
                <Insets top="20"/>
            </padding>
        </Label>
    </VBox>
</ScrollPane>