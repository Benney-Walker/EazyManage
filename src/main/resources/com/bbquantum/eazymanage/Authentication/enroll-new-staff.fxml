<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.EnrollStaffController"
            style="-fx-background: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">

    <VBox alignment="TOP_CENTER" spacing="25.0"
          style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="50.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="👤" style="-fx-font-size: 48px;"/>
            <Label text="STAFF ENROLLMENT" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Create your staff account" style="-fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
        </VBox>

        <!-- Enrollment Form -->
        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40;" maxWidth="600">
            <effect>
                <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
            </effect>

            <!-- Personal Information Section -->
            <Label text="Personal Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- First Name and Last Name (Side by Side) -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="First Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <TextField fx:id="firstNameField" promptText="Enter first name"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Last Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <TextField fx:id="lastNameField" promptText="Enter last name"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                </VBox>
            </HBox>

            <!-- Gender Selection -->
            <VBox spacing="8">
                <Label text="Gender *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <HBox spacing="20">
                    <RadioButton fx:id="maleRadio" text="Male" style="-fx-font-size: 13px;">
                        <toggleGroup>
                            <ToggleGroup fx:id="genderGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="femaleRadio" text="Female" toggleGroup="$genderGroup" style="-fx-font-size: 13px;"/>
                </HBox>
            </VBox>

            <!-- Date of Birth -->
            <VBox spacing="8">
                <Label text="Date of Birth *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <DatePicker fx:id="dateOfBirthPicker" promptText="Select date of birth"
                            style="-fx-font-size: 14px;" maxWidth="Infinity"/>
            </VBox>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Contact Information Section -->
            <Label text="Contact Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- Email -->
            <VBox spacing="8">
                <Label text="Email Address *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="emailField" promptText="example@email.com"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Phone Number -->
            <VBox spacing="8">
                <Label text="Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="phoneNumberField" promptText="0XX XXX XXXX"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Account Information Section -->
            <Label text="Account Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- Institution ID -->
            <VBox spacing="8">
                <Label text="Institution ID *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="institutionIdField" promptText="Enter your institution ID"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                <Label text="💡 This was provided after school subscription"
                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-padding: 5 0 0 0;"/>
            </VBox>

            <!-- Role Selection -->
            <VBox spacing="8">
                <Label text="Role *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <ComboBox fx:id="roleComboBox" promptText="Select your role" maxWidth="Infinity"
                          style="-fx-font-size: 14px;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="8">
                <Label text="Create Password *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <PasswordField fx:id="passwordField" promptText="Create a strong password"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Confirm Password -->
            <VBox spacing="8">
                <Label text="Confirm Password *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Error/Success Message Label -->
            <Label fx:id="messageLabel" wrapText="true" style="-fx-font-size: 13px; -fx-padding: 5;" visible="false"/>

            <!-- Enroll Button -->
            <Button fx:id="enrollButton" text="Enroll Staff" onAction="#handleEnrollStaff" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 8; -fx-cursor: hand;">
                <effect>
                    <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                </effect>
            </Button>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Success Panel (Hidden by default) -->
            <VBox fx:id="successPanel" spacing="20" alignment="CENTER" visible="false"
                  style="-fx-background-color: #d4edda; -fx-background-radius: 10; -fx-padding: 30; -fx-border-color: #28a745; -fx-border-radius: 10; -fx-border-width: 2;">

                <Label text="✅ Enrollment Successful!" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #155724;"/>

                <VBox spacing="15" alignment="CENTER">
                    <!-- Staff ID Display -->
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Your Staff ID:" style="-fx-font-size: 13px; -fx-text-fill: #155724;"/>
                        <Label fx:id="staffIdLabel" text=""
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #155724; -fx-background-color: white; -fx-padding: 15 30 15 30; -fx-background-radius: 8;"/>
                    </VBox>

                    <!-- Password Display -->
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Your Password:" style="-fx-font-size: 13px; -fx-text-fill: #155724;"/>
                        <Label fx:id="passwordDisplayLabel" text=""
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #155724; -fx-background-color: white; -fx-padding: 12 25 12 25; -fx-background-radius: 8;"/>
                    </VBox>
                </VBox>

                <VBox alignment="CENTER" spacing="5">
                    <Label text="⚠️ IMPORTANT: Save these credentials!"
                           style="-fx-font-size: 13px; -fx-text-fill: #155724; -fx-font-weight: bold;"/>
                    <Label text="You'll need them to login to the system"
                           style="-fx-font-size: 12px; -fx-text-fill: #155724; -fx-font-style: italic;"/>
                </VBox>

                <!-- Back to Login Link -->
                <Hyperlink fx:id="backToLoginLink" text="🏠 Go to Login Page" onAction="#handleBackToLogin"
                           style="-fx-font-size: 15px; -fx-text-fill: #007bff; -fx-font-weight: bold; -fx-underline: true;"/>
            </VBox>

            <!-- Back to Login Link (for non-enrolled users) -->
            <Hyperlink text="← Already have an account? Login" onAction="#handleBackToLogin"
                       style="-fx-text-fill: #667eea; -fx-font-size: 12px; -fx-alignment: center;"/>
        </VBox>

        <!-- Footer -->
        <Label text="© 2025 BBQuantum | Empowering Education"
               style="-fx-font-size: 11px; -fx-text-fill: white;">
            <padding>
                <Insets top="20"/>
            </padding>
        </Label>
    </VBox>
</ScrollPane>
