<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Polygon?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.bbquantum.eazymanage.Controller.AuthController"
           styleClass="auth-root">

    <stylesheets>
        <URL value="@../Styles/Styles.css"/>
    </stylesheets>

    <!-- MAIN RECTANGULAR CONTAINER -->
    <HBox
          maxWidth="1000"
          maxHeight="540"
          styleClass="auth-main-card">

        <!-- LEFT INFO PANEL -->
        <VBox
              spacing="22"
              alignment="CENTER"
              HBox.hgrow="ALWAYS"
              styleClass="auth-info-panel">

            <Label text="EAZY MANAGE" styleClass="auth-brand-title"/>
            <Label text="Smart School Management"
                   wrapText="true"
                   styleClass="auth-brand-subtitle"/>

            <VBox fx:id="info"
                  spacing="10"
                  alignment="CENTER">
                <Label text="✔ Secure Student Records"/>
                <Label text="✔ Attendance &amp; Results"/>
                <Label text="✔ Finance &amp; Analytics"/>
            </VBox>
            <VBox spacing="10"
                  alignment="CENTER"
                  fx:id="messageBox"
                  visible="false"
                  managed="false">
                <Label fx:id="errorLabel" text=" " styleClass="message-error"/>
                <Label fx:id="messageLabel" text=" " styleClass="message-success"/>
                <Label fx:id="institutionIdLabel" text=" " styleClass="message-success"/>

                <Hyperlink fx:id="enrollPrincipal"
                           visible="false"
                           managed="false"
                           text="Enroll Principal"
                           onAction="#handleEnrollPrincipal"
                           styleClass="auth-link"/>
            </VBox>
        </VBox>

        <!-- DIAGONAL DIVIDER -->
        <Polygon points="0,0,40,0,0,540"
                 styleClass="auth-diagonal-divider"/>

        <!-- RIGHT PANEL -->
        <StackPane
                   HBox.hgrow="ALWAYS"
                   styleClass="auth-form-panel">

            <!-- LOGIN FORM -->
            <VBox fx:id="loginForm"
                  spacing="18"
                  alignment="CENTER"
                  maxWidth="360"
                  styleClass="auth-form-card">

                <Label text="Login" styleClass="auth-form-title"/>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Enter Staff ID:" styleClass="input-label"/>
                    <TextField fx:id="usernameField"
                               promptText="Staff ID"
                               styleClass="auth-input"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Enter Password:" styleClass="input-label"/>

                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="passwordField"
                                           promptText="Password"
                                           styleClass="auth-input"/>

                            <TextField fx:id="passwordTextField"
                                       promptText="Password"
                                       styleClass="auth-input"
                                       visible="false" managed="false"/>
                        </StackPane>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <CheckBox fx:id="showPasswordTick"
                                  onAction="#togglePassword"
                                  styleClass="action-button-outline"/>

                        <Label text="show password" styleClass="input-label"/>
                    </HBox>
                </VBox>

                <Button fx:id="loginButton"
                        text="SIGN IN"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        styleClass="auth-primary-btn"/>

                <Hyperlink text="Enroll Staff"
                           onAction="#handleEnrollNewStaff"
                           styleClass="auth-link"/>

                <Hyperlink text="Register Institution"
                           onAction="#switchToSubscription"
                           styleClass="auth-link-accent"/>
            </VBox>

            <!-- SUBSCRIPTION FORM -->
            <VBox fx:id="subscriptionForm"
                  spacing="18"
                  alignment="CENTER"
                  maxWidth="380"
                  visible="false"
                  managed="false"
                  styleClass="auth-form-card">

                <Label text="Institution Activation"
                       styleClass="auth-form-title"/>

                <TextField fx:id="schoolNameField"
                           promptText="Institution Name"
                           styleClass="auth-input"/>

                <TextField fx:id="subscriptionCodeField"
                           promptText="Subscription Code"
                           styleClass="auth-input"/>

                <Button fx:id="subscribeButton"
                        text="Activate Institution"
                        onAction="#handleSubscribe"
                        maxWidth="Infinity"
                        styleClass="auth-primary-btn"/>

                <Hyperlink text="← Back to Login"
                           fx:id="backToLoginLink"
                           onAction="#switchToLogin"
                           styleClass="auth-link"/>
            </VBox>

        </StackPane>
    </HBox>
</StackPane>
