<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.AddStudentController"
            style="-fx-background: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">

    <VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="50.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎓" style="-fx-font-size: 48px;"/>
            <Label text="ADD NEW STUDENT" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Enroll a new student to your class" style="-fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
        </VBox>

        <!-- Form -->
        <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;" maxWidth="650">
            <effect>
                <javafx.scene.effect.DropShadow color="#00000040" radius="20" offsetY="5"/>
            </effect>

            <!-- Personal Information Section -->
            <Label text="Personal Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- First Name and Last Name -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="First Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <TextField fx:id="firstNameField" promptText="Enter first name"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Last Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <TextField fx:id="lastNameField" promptText="Enter last name"
                               style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                </VBox>
            </HBox>

            <!-- Gender and Date of Birth -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Gender *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="genderComboBox" promptText="Select Gender" maxWidth="Infinity"
                              style="-fx-font-size: 14px;"/>
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Date of Birth *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                    <DatePicker fx:id="dateOfBirthPicker" promptText="Select date of birth" maxWidth="Infinity"
                                style="-fx-font-size: 14px;"/>
                </VBox>
            </HBox>

            <!-- Home Town -->
            <VBox spacing="8">
                <Label text="Home Town *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="homeTownField" promptText="Enter home town"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Parent/Guardian Information Section -->
            <Label text="Parent/Guardian Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- Parent Name -->
            <VBox spacing="8">
                <Label text="Parent/Guardian Name *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="parentNameField" promptText="Enter parent or guardian name"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <!-- Parent Phone Number -->
            <VBox spacing="8">
                <Label text="Parent Phone Number *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <TextField fx:id="parentPhoneField" promptText="0XX XXX XXXX"
                           style="-fx-padding: 12; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
            </VBox>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Class Information Section -->
            <Label text="Class Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>

            <!-- Class Selection -->
            <VBox spacing="8">
                <Label text="Class/Level *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <ComboBox fx:id="classComboBox" promptText="Select Class" maxWidth="Infinity"
                          style="-fx-font-size: 14px;"/>
                <Label text="💡 Select which class this student belongs to"
                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Message Label -->
            <Label fx:id="messageLabel" wrapText="true" style="-fx-font-size: 13px; -fx-padding: 5;" visible="false"/>

            <Separator style="-fx-padding: 10 0 10 0;"/>

            <!-- Action Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="💾 Save and Clear" onAction="#handleSaveAndClear"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                    <effect>
                        <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                    </effect>
                </Button>

                <Button text="💾 Save and Close" onAction="#handleSaveAndClose"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;">
                    <effect>
                        <javafx.scene.effect.DropShadow color="#00000030" radius="5" offsetY="2"/>
                    </effect>
                </Button>
                </HBox>

            <!-- Help Text -->
            <VBox spacing="5" style="-fx-background-color: #e8f4f8; -fx-background-radius: 8; -fx-padding: 15;">
                <Label text="💡 Quick Tips:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="• Click 'Save and Clear' to add multiple students quickly"
                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <Label text="• Click 'Save and Close' to save and return to dashboard"
                       style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
