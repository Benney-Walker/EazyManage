<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bbquantum.eazymanage.Controller.StaffController"
            style="-fx-background-color: #f5f7fa;">

    <!-- LEFT SIDEBAR - Navigation -->
    <left>
        <VBox spacing="0" style="-fx-background-color: #2c3e50; -fx-min-width: 250; -fx-pref-width: 250;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 30 20 30 20; -fx-background-color: #1a252f;">
                <Label text="📚" style="-fx-font-size: 40px;"/>
                <Label text="EAZY MANAGE" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Staff Portal" style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
            </VBox>

            <Separator style="-fx-background-color: #34495e;"/>

            <!-- Navigation Menu -->
            <VBox spacing="5" style="-fx-padding: 20 10 20 10;">

                <!-- Dashboard Button -->
                <Button fx:id="dashboardBtn" text="📊 Dashboard" onAction="#showDashboard"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand;">
                </Button>

                <!-- Add Student Button -->
                <Button fx:id="addStudentBtn" text="➕ Add New Student" onAction="#showAddStudent"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>

                <!-- Add Results Button -->
                <Button fx:id="addResultsBtn" text="📝 Add Subject Results" onMouseClicked="#showAddResults"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-font-size: 14px; -fx-padding: 15 20 15 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;">
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Info & Logout -->
            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #1a252f;">
                <Separator style="-fx-background-color: #34495e;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 24px;"/>
                    <VBox spacing="2">
                        <Label fx:id="institutionalNameLabel" text="Staff Name" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="staffNameLabel" text="Teacher" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand;">
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- RIGHT CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f5f7fa;">

            <!-- MAIN DASHBOARD VIEW -->
            <ScrollPane fx:id="dashboardView" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="25" style="-fx-padding: 30;">

                    <!-- Header -->
                    <VBox spacing="5">
                        <Label text="Staff Dashboard" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label fx:id="dateTimeLabel" text=" " style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <!-- Class Info Card -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Class Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <Separator/>

                        <GridPane hgap="30" vgap="15">
                            <!-- Class Name -->
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Class/Level:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="classNameLabel" text=" " style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            </VBox>

                            <!-- Total Students -->
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Total Students:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="totalStudentsLabel" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                            </VBox>

                            <!-- Subject -->
                            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0" visible="false">
                                <Label text="Assigned Subjects:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="subjectsLabel" text="Mathematics, Science" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Quick Action Cards -->
                    <HBox spacing="20">

                        <!-- Add Student Card -->
                        <Button onAction="#showAddStudent"
                                style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                                HBox.hgrow="ALWAYS" maxHeight="Infinity">
                            <graphic>
                                <VBox spacing="10" alignment="CENTER">
                                    <Label text="➕" style="-fx-font-size: 48px;"/>
                                    <Label text="Add New Student" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label text="Enroll students to your class" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                                </VBox>
                            </graphic>
                        </Button>

                        <!-- Add Results Card -->
                        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c); -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS" onMouseClicked="#showAddResults">
                            <Label text="📝" style="-fx-font-size: 48px;"/>
                            <Label text="Add Subject Results" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Enter scores for your subjects" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                        </VBox>
                        <!-- Add Subject Button Card -->
                        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS" onMouseClicked="#openAddSubjectPage">
                            <Label text="📚" style="-fx-font-size: 36px;"/>
                            <Label text="Add Subject" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Create new subject" style="-fx-font-size: 12px; -fx-text-fill: #e0e0e0;"/>
                        </VBox>
                    </HBox>

                    <!-- Class Students Table -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋Students List" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Refresh" onAction="#refreshDashboard"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        </HBox>

                        <Separator/>

                        <TableView fx:id="studentsTable" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn text="Student ID" prefWidth="120" fx:id="studentIdCol"/>
                                <TableColumn text="Full Name" prefWidth="200" fx:id="studentNameCol"/>
                                <TableColumn text="Gender" prefWidth="100" fx:id="genderCol"/>
                                <TableColumn text="Home Town" prefWidth="150" fx:id="homeTownCol"/>
                                <TableColumn text="Parent Name" prefWidth="180" fx:id="parentNameCol"/>
                                <TableColumn text="Parent Phone" prefWidth="130" fx:id="parentPhoneCol"/>
                            </columns>
                            <placeholder>
                                <Label text="No students in your class" style="-fx-text-fill: #95a5a6;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>
